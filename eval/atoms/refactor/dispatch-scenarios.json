{
  "suite": "refactor-atom-dispatch",
  "version": 1,
  "notes": "Per-atom dispatch scenarios with a fixture input and a response-shape assertion. The eval runner installs each atom, calls atom_invoke with the fixture args, and asserts the returned response shape contains the named fields. The recording adapter (see behavior-smoke.json) is the v1 default for behavior assertions; this suite covers the install-then-dispatch surface only.",
  "scenarios": [
    {
      "id": "dispatch-impl-partition-graph",
      "atom": "rust-impl-partition-graph",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/main.rs",
        "impl_name": "impl Foo"
      },
      "expect_response_fields": [
        "status",
        "methods",
        "fields",
        "edges"
      ]
    },
    {
      "id": "dispatch-public-api-guard",
      "atom": "rust-public-api-guard",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source": "src/lib.rs"
      },
      "expect_response_fields": [
        "status",
        "advisory_severity"
      ]
    },
    {
      "id": "dispatch-test-island-extract-planonly",
      "atom": "rust-test-island-extract",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file_or_dir": "src/main.rs",
        "target_dir": "src/tests",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "extracted_test_files"
      ]
    },
    {
      "id": "dispatch-state-extract-planonly",
      "atom": "rust-state-extract",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/main.rs",
        "source_struct": "Foo",
        "target_struct_name": "FooState",
        "target_module_path": "src/foo_state.rs",
        "field_names": [
          "a",
          "b",
          "c"
        ],
        "delegate_field": "state",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "delegate_field",
        "accessors_generated"
      ]
    },
    {
      "id": "dispatch-trait-from-impl-planonly",
      "atom": "rust-trait-from-impl",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/main.rs",
        "source_struct": "Foo",
        "trait_name": "FooApi",
        "target_file": "src/foo_api.rs",
        "method_names": [
          "bar",
          "baz"
        ],
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "trait_file",
        "methods_lifted",
        "object_safe"
      ]
    },
    {
      "id": "dispatch-error-migrate-planonly",
      "atom": "rust-error-migrate",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file_or_module": "src/error.rs",
        "from_type": "OldErr",
        "to_type": "NewErr",
        "error_mapping": {
          "OldErr::Bad(msg)": "NewErr::Bad { msg }"
        },
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "signatures_rewritten",
        "construction_sites_rewritten"
      ]
    },
    {
      "id": "dispatch-split-god-impl-planonly",
      "atom": "rust-split-god-impl",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/main.rs",
        "impl_name": "impl BigStruct",
        "partition": {
          "search": [
            "search_a",
            "search_b"
          ],
          "knowledge": [
            "knowledge_a",
            "knowledge_b"
          ]
        },
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "partitions"
      ]
    },
    {
      "id": "dispatch-rust-rename-symbol-planonly",
      "atom": "rust-rename-symbol",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/lib.rs",
        "old_name": "old_name",
        "new_name": "new_name",
        "item_kinds": [
          "function"
        ],
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "old_name",
        "new_name",
        "guard_severity"
      ]
    },
    {
      "id": "dispatch-rust-extract-to-submodule-planonly",
      "atom": "rust-extract-to-submodule",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/lib.rs",
        "target_file": "src/extracted.rs",
        "item_names": [
          "Widget"
        ],
        "module_name": "extracted",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "target_file",
        "items_moved"
      ]
    },
    {
      "id": "dispatch-rust-extract-impl-methods-planonly",
      "atom": "rust-extract-impl-methods",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/main.rs",
        "target_file": "src/foo_methods.rs",
        "impl_name": "impl Foo",
        "method_names": [
          "bar"
        ],
        "module_name": "foo_methods",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "files_touched",
        "methods_extracted"
      ]
    },
    {
      "id": "dispatch-rust-bin-to-lib-migration-planonly",
      "atom": "rust-bin-to-lib-migration",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/main.rs",
        "target_file": "src/lib.rs",
        "module_names": [
          "search"
        ],
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "files_touched",
        "modules_migrated"
      ]
    },
    {
      "id": "dispatch-rust-organize-imports-planonly",
      "atom": "rust-organize-imports",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "source_file": "src/lib.rs",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "files_touched",
        "import_edits"
      ]
    },
    {
      "id": "dispatch-rust-cargo-add-dep-planonly",
      "atom": "rust-cargo-add-dep",
      "args": {
        "project_dir": "${FIXTURE_RUST_PROJECT}",
        "crate_name": "serde",
        "version": "1",
        "features": [
          "derive"
        ],
        "apply": false,
        "skip_validation": true
      },
      "expect_response_fields": [
        "status",
        "crate_name",
        "toml_table",
        "entry_shape"
      ]
    },
    {
      "id": "dispatch-java-extract-cohesive-class-planonly",
      "atom": "java-extract-cohesive-class",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/DashboardView.java",
        "target": "src/main/java/com/example/DashboardMeterGrid.java",
        "module_name": "DashboardMeterGrid",
        "item_names": [
          "getMeterGrid",
          "refreshMeterData"
        ],
        "move_fields": [
          "meterGrid",
          "meterDataProvider"
        ],
        "delegate_field": "meterGrid",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "methods_moved",
        "fields_moved",
        "delegate_field"
      ]
    },
    {
      "id": "dispatch-java-promote-inner-class-planonly",
      "atom": "java-promote-inner-class",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/Outer.java",
        "target": "src/main/java/com/example/Promoted.java",
        "module_name": "Promoted",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "promoted_class_name",
        "captures"
      ]
    },
    {
      "id": "dispatch-java-extract-interface-planonly",
      "atom": "java-extract-interface",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/ServiceImpl.java",
        "target": "src/main/java/com/example/Service.java",
        "module_name": "Service",
        "item_names": [
          "process",
          "validate"
        ],
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "interface_file",
        "methods_lifted"
      ]
    },
    {
      "id": "dispatch-java-lombokify-planonly",
      "atom": "java-lombokify",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/Pair.java",
        "boolean_getter_strategy": "skip",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "files_lombokified",
        "annotation_distribution"
      ]
    },
    {
      "id": "dispatch-java-public-api-guard-planonly",
      "atom": "java-public-api-guard",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example",
        "proposed_changes": [
          {
            "file": "src/main/java/com/example/ServiceImpl.java",
            "item_name": "ServiceImpl",
            "change_kind": "modify"
          }
        ]
      },
      "expect_response_fields": [
        "status",
        "advisory_severity",
        "public_items_touched"
      ]
    },
    {
      "id": "dispatch-java-class-dependency-graph-planonly",
      "atom": "java-class-dependency-graph",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/DashboardView.java",
        "module_name": "DashboardView"
      },
      "expect_response_fields": [
        "status",
        "class",
        "methods",
        "fields",
        "inner_types",
        "annotations_class_level"
      ]
    },
    {
      "id": "dispatch-java-find-usages-planonly",
      "atom": "java-find-usages",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "item_names": [
          "refreshGrid"
        ]
      },
      "expect_response_fields": [
        "status",
        "total_usages",
        "production_sites",
        "test_sites"
      ]
    },
    {
      "id": "dispatch-java-rename-symbol-planonly",
      "atom": "java-rename-symbol",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/ServiceImpl.java",
        "old_name": "process",
        "new_name": "processRequest",
        "item_kinds": [
          "method_declaration"
        ],
        "apply": false,
        "apply_file_rename": false
      },
      "expect_response_fields": [
        "status",
        "old_name",
        "new_name",
        "guard_severity",
        "file_rename_advisory"
      ]
    },
    {
      "id": "dispatch-java-extract-static-nested-class-planonly",
      "atom": "java-extract-static-nested-class",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/Outer.java",
        "target": "src/main/java/com/example/Helper.java",
        "item_names": [
          "Helper"
        ],
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "nested_types_moved",
        "target_file"
      ]
    },
    {
      "id": "dispatch-java-organize-imports-planonly",
      "atom": "java-organize-imports",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/DashboardView.java",
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "semantic_status",
        "import_edits"
      ]
    },
    {
      "id": "dispatch-java-extract-methods-light-planonly",
      "atom": "java-extract-methods-light",
      "args": {
        "project_dir": "${FIXTURE_JAVA_PROJECT}",
        "source": "src/main/java/com/example/UtilitySource.java",
        "target": "src/main/java/com/example/UtilityTarget.java",
        "module_name": "UtilityTarget",
        "item_names": [
          "normalize"
        ],
        "apply": false
      },
      "expect_response_fields": [
        "status",
        "methods_moved",
        "target_file",
        "dependency_warnings"
      ]
    }
  ]
}
