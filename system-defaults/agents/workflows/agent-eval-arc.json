{
  "name": "agent-eval-arc",
  "version": 1,
  "actors": {},
  "start": "RunDiscoveryQueries",
  "vars_schema": {
    "query": { "kind": "string", "required": true },
    "search_result": { "kind": "any" },
    "eval_result": { "kind": "string" }
  },
  "nodes": {
    "RunDiscoveryQueries": {
      "prompt": "Run one agent discovery query through bro_agent_search.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_search",
            "arguments": {
              "query": "${vars.query}",
              "limit": 5,
              "include_vectors": true
            },
            "timeout_secs": 60
          },
          "into_var": "search_result",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": {
            "name": "eval_result",
            "value": "agent_search_completed"
          }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
