{
  "domain": "hook-route/proposal-page",
  "version": 1,
  "scope": "global",
  "classification_lattice": [
    "more",
    "done"
  ],
  "rules": [
    {
      "id": "more_when_page_has_tail",
      "classification": "more",
      "antecedent": {
        "op": "Eq",
        "field": "vars.proposals_response.has_more",
        "value": true
      },
      "consequent": "more"
    },
    {
      "id": "done_when_page_is_complete",
      "classification": "done",
      "antecedent": {
        "op": "Eq",
        "field": "vars.proposals_response.has_more",
        "value": false
      },
      "consequent": "done"
    }
  ]
}
