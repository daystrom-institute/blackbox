{
  "domain": "hook-when/apply-failed",
  "version": 3,
  "scope": "global",
  "classification_lattice": ["allow", "deny"],
  "rules": [
    {
      "id": "allow_when_begin_rejected",
      "classification": "allow",
      "antecedent": {
        "op": "Eq",
        "field": "vars.begin_response.outcome",
        "value": "rejected"
      },
      "consequent": "allow"
    },
    {
      "id": "allow_when_complete_returned_failed",
      "classification": "allow",
      "antecedent": {
        "op": "Eq",
        "field": "vars.complete_response.status",
        "value": "failed"
      },
      "consequent": "allow"
    },
    {
      "id": "fallback_deny",
      "classification": "deny",
      "antecedent": { "op": "True" },
      "consequent": "deny"
    }
  ]
}
