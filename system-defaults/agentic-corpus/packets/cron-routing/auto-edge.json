{
  "domain": "cron-routing/auto-edge",
  "version": 1,
  "scope": "global",
  "classification_lattice": ["start_arc", "ignore"],
  "rules": [
    {
      "id": "nightly_auto_edge_starts_arc",
      "classification": "start_arc",
      "antecedent": {
        "op": "Eq",
        "field": "cron_name",
        "value": "auto-edge-nightly"
      },
      "consequent": "{\"route\":\"start_arc\",\"workflow\":\"auto-edge-arc\",\"initial_vars\":{\"scan_cap\":50}}"
    },
    {
      "id": "ignore_unknown_cron",
      "classification": "ignore",
      "antecedent": { "op": "True" },
      "consequent": "ignore"
    }
  ]
}
