{
  "domain": "embed/compaction-policy",
  "version": 1,
  "scope": "global",
  "classification_lattice": ["compact", "notify", "skip"],
  "rules": [
    {
      "id": "compact_deleted_ratio_over_30pct",
      "classification": "compact",
      "antecedent": {
        "op": "GtF",
        "field": "vars.vector_status.max_deleted_ratio",
        "value": 0.3
      },
      "consequent": "compact"
    },
    {
      "id": "notify_deleted_ratio_over_15pct",
      "classification": "notify",
      "antecedent": {
        "op": "GtF",
        "field": "vars.vector_status.max_deleted_ratio",
        "value": 0.15
      },
      "consequent": "notify"
    },
    {
      "id": "skip_default",
      "classification": "skip",
      "antecedent": { "op": "True" },
      "consequent": "skip"
    }
  ]
}
