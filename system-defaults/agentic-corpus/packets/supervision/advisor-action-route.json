    {
      "id": "bail",
      "classification": "bail",
      "antecedent": {
        "op": "Any",
        "args": [
          { "op": "Eq", "field": "vars.advisor_action.action", "value": "bail" },
          { "op": "StringMatches", "field": "output", "pattern": "\"action\"\\s*:\\s*\"bail\"" }
        ]
