{
  "domain": "supervision/advisor-action-route",
  "version": 1,
  "scope": "global",
  "classification_lattice": [
    "accept",
    "continue_observing",
    "steer_primary",
    "cancel_and_retry",
    "replace_primary",
    "escalate_human",
    "bail",
    "invalid_action"
  ],
  "prefix_inference": {},
  "rules": [
    {
      "id": "accept",
      "classification": "accept",
      "antecedent": {
        "op": "Any",
        "args": [
          { "op": "Eq", "field": "vars.advisor_action.action", "value": "accept" },
          { "op": "StringMatches", "field": "output", "pattern": "\"action\"\\s*:\\s*\"accept\"" }
        ]
      },
      "consequent": "accept"
    },
    {
      "id": "continue_observing",
      "classification": "continue_observing",
      "antecedent": {
        "op": "Any",
