{
  "domain": "phase-decompose/whiteboard-participation",
  "version": 2,
  "scope": "global",
  "classification_lattice": ["invalid", "ready"],
  "prefix_inference": {},
  "rules": [
    {
      "id": "blind_all_specialists_posted",
      "classification": "ready",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "vars.board_check.phase", "value": "blind" },
          { "op": "Ge", "field": "vars.board_check.post_count", "value": 3 },
          { "op": "Eq", "field": "vars.board_check.agents.architecture.has_posted", "value": true },
          { "op": "Eq", "field": "vars.board_check.agents.implementation.has_posted", "value": true },
          { "op": "Eq", "field": "vars.board_check.agents.risk.has_posted", "value": true }
        ]
      },
      "consequent": "ready"
    },
    {
      "id": "debate_has_votes",
      "classification": "ready",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "vars.board_check.phase", "value": "debate" },
          { "op": "Ge", "field": "vars.board_check.post_count", "value": 3 },
          { "op": "Eq", "field": "vars.board_check.unresolved_challenges", "value": 0 },
          { "op": "Ge", "field": "vars.board_check.vote_count", "value": 1 }
        ]
      },
      "consequent": "ready"
    },
    {
      "id": "invalid_default",
      "classification": "invalid",
      "antecedent": { "op": "True" },
      "consequent": "invalid"
    }
  ]
}
