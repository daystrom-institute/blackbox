{
  "name": "arch-pathology-rust",
  "version": 3,
  "vars_schema": {
    "project_dir": {
      "kind": "string",
      "required": true
    },
    "scope_filter": {
      "kind": "string",
      "required": true
    },
    "target_context_window": {
      "kind": "int",
      "required": true
    },
    "operator_hints": {
      "kind": "array"
    },
    "target_loci": {
      "kind": "array"
    },
    "layer_model_path": {
      "kind": "string"
    },
    "whole_project_mode": {
      "kind": "bool"
    },
    "baseline_result": {
      "kind": "object"
    },
    "survey_json": {
      "kind": "object"
    },
    "atom_requests": {
      "kind": "array"
    },
    "atom_results": {
      "kind": "array"
    },
    "whiteboard_id": {
      "kind": "string"
    },
    "whiteboard_open": {
      "kind": "object"
    },
    "board_check": {
      "kind": "object"
    },
    "board_summary": {
      "kind": "object"
    },
    "plan_json": {
      "kind": "object"
    },
    "write_result": {
      "kind": "object"
    }
  },
  "actors": {
    "facilitator": {
      "kind": "executor",
      "brofile": "rust-architecture-pathologist",
      "durable": true,
      "compaction_anchor": true
    },
    "panel": {
      "kind": "ensemble",
      "team": "rust-pathology-panel",
      "durable": true
    },
    "validator": {
      "kind": "executor",
      "brofile": "arch-rust-pathology-validator",
      "durable": true
    }
  },
  "start": "Setup",
  "nodes": {
    "Setup": {
      "actor": "",
      "on_enter": [
        {
          "op": "default_var",
          "args": {
            "key": "operator_hints",
            "value": []
          }
        },
        {
          "op": "default_var",
          "args": {
            "key": "target_loci",
            "value": []
          }
        },
        {
          "op": "default_var",
          "args": {
            "key": "layer_model_path",
            "value": ""
          }
        },
        {
          "op": "default_var",
          "args": {
            "key": "whole_project_mode",
            "value": false
          }
        },
        {
          "op": "set_var",
          "args": {
            "key": "whiteboard_id",
            "value": "arch-pathology-rust:${meta.arc_id}"
          }
        },
        {
          "op": "shell",
          "args": {
            "argv": [
              "git",
              "rev-parse",
              "HEAD"
            ],
            "cwd": "${vars.project_dir}"
          },
          "into_var": "baseline_result",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_open",
            "arguments": {
              "board_id": "${vars.whiteboard_id}",
              "opened_by": "facilitator",
              "project": "${vars.project_dir}",
              "topic": "Rust architecture pathology review for ${vars.scope_filter}",
              "domain": "rust-architecture-pathology"
            },
            "timeout_secs": 30
          },
          "into_var": "whiteboard_open",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "agent_name": "soundness",
              "board_id": "${vars.whiteboard_id}",
              "domain": "rust-architecture-pathology",
              "role": "specialist"
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "agent_name": "precision",
              "board_id": "${vars.whiteboard_id}",
              "domain": "rust-architecture-pathology",
              "role": "specialist"
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "agent_name": "economy",
              "board_id": "${vars.whiteboard_id}",
              "domain": "rust-architecture-pathology",
              "role": "specialist"
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "agent_name": "resilience",
              "board_id": "${vars.whiteboard_id}",
              "domain": "rust-architecture-pathology",
              "role": "specialist"
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "agent_name": "corroboration",
              "board_id": "${vars.whiteboard_id}",
              "domain": "rust-architecture-pathology",
              "role": "specialist"
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "agent_name": "validator",
              "board_id": "${vars.whiteboard_id}",
              "domain": "rust-architecture-pathology",
              "role": "specialist"
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        }
      ],
      "next": {
        "type": "goto",
        "to": "Survey"
      }
    },
    "Survey": {
      "actor": "facilitator",
      "prompt": "Run the cheap survey for Rust architecture pathology.\n\nProject: ${vars.project_dir}\nScope filter: ${vars.scope_filter}\nWhole-project mode: ${vars.whole_project_mode}\nTarget loci: ${vars.target_loci}\nOperator hints: ${vars.operator_hints}\nLayer model path: ${vars.layer_model_path}\nTarget context window: ${vars.target_context_window}\nWhiteboard id: ${vars.whiteboard_id}\n\nUse cheap measurement before LLM judgment: bbox_code_symbols, bbox_refactor_status, bbox_refactor_plan(kind=\"rust_impl_partition_analysis\") for concrete candidate impls, rust_public_api_guard when public surfaces may be touched, cargo metadata observations where available, cfg/macro density, tests, and bbox_hybrid_search/bbox_notes/bbox_search for transcript pressure when hints or history point there. Do not run every atom. Select a bounded top set of atom requests whose diagnostic question is justified by the survey. Do not post to the whiteboard yet; the lens panel posts blind diagnoses next.\n\nReturn strict JSON only with keys: survey_summary, pressure_map, target_loci, atom_requests, deferred_hotspots, limits. atom_requests must be an array of objects shaped {\"atom_ref\":\"atom:rust-architecture-impl-role-coherence@v1\",\"args\":{...}}. Each args object must include project_dir, scope_filter, target_loci, operator_hints, layer_model_path, survey_json, target_context_window, whole_project_mode, and whiteboard_id. Use only these atom refs: atom:rust-architecture-impl-role-coherence@v1, atom:rust-architecture-state-ownership-collapse@v1, atom:rust-architecture-construction-boundary-collapse@v1, atom:rust-architecture-trait-boundary-mismatch@v1, atom:rust-architecture-module-topology-drift@v1, atom:rust-architecture-error-contract-drift@v1, atom:rust-architecture-feature-cfg-matrix@v1, atom:rust-architecture-async-runtime-lifecycle@v1, atom:rust-architecture-test-implied-architecture@v1, atom:rust-architecture-unsafe-contract-opacity@v1, atom:rust-architecture-macro-generated-contract-opacity@v1, atom:rust-architecture-transcript-anchored-pressure@v1. If evidence is weak, return fewer atom_requests and explain the limit. First byte {, final byte }.",
      "on_exit": [
        {
          "op": "parse_json",
          "args": {
            "from": "${Survey.output}",
            "repair_missing_closing_delimiters": true
          },
          "into_var": "survey_json",
          "on_failure": "halt"
        },
        {
          "op": "normalize_arch_pathology_atom_requests",
          "args": {
            "requests": "${vars.survey_json.atom_requests}",
            "allowed_atoms": [
              "atom:rust-architecture-impl-role-coherence@v1",
              "atom:rust-architecture-state-ownership-collapse@v1",
              "atom:rust-architecture-construction-boundary-collapse@v1",
              "atom:rust-architecture-trait-boundary-mismatch@v1",
              "atom:rust-architecture-module-topology-drift@v1",
              "atom:rust-architecture-error-contract-drift@v1",
              "atom:rust-architecture-feature-cfg-matrix@v1",
              "atom:rust-architecture-async-runtime-lifecycle@v1",
              "atom:rust-architecture-test-implied-architecture@v1",
              "atom:rust-architecture-unsafe-contract-opacity@v1",
              "atom:rust-architecture-macro-generated-contract-opacity@v1",
              "atom:rust-architecture-transcript-anchored-pressure@v1"
            ],
            "defaults": {
              "project_dir": "${vars.project_dir}",
              "scope_filter": "${vars.scope_filter}",
              "target_loci": "${vars.target_loci}",
              "operator_hints": "${vars.operator_hints}",
              "layer_model_path": "${vars.layer_model_path}",
              "survey_json": "${vars.survey_json}",
              "target_context_window": "${vars.target_context_window}",
              "whole_project_mode": "${vars.whole_project_mode}",
              "whiteboard_id": "${vars.whiteboard_id}"
            }
          },
          "into_var": "atom_requests",
          "on_failure": "halt"
        }
      ],
      "next": {
        "type": "goto",
        "to": "FocusedAtoms"
      }
    },
    "FocusedAtoms": {
      "actor": "",
      "foreach": {
        "items": "${vars.atom_requests}",
        "as_var": "atom_request",
        "index_as": "atom_index",
        "key": "atom-${vars.atom_index}",
        "imports": [
          "project_dir"
        ],
        "exports": [
          "atom_result"
        ],
        "parallelism": 3,
        "on_item_failure": "collect_then_halt",
        "collect": {
          "into_var": "atom_results"
        },
        "subworkflow": {
          "name": "arch-pathology-rust-atom-child",
          "version": 1,
          "vars_schema": {
            "project_dir": {
              "kind": "string",
              "required": true
            },
            "atom_request": {
              "kind": "object",
              "required": true
            },
            "atom_handle": {
              "kind": "object"
            },
            "atom_wait": {
              "kind": "object"
            },
            "atom_status": {
              "kind": "object"
            },
            "atom_result": {
              "kind": "object"
            }
          },
          "actors": {},
          "start": "InvokeAtom",
          "nodes": {
            "InvokeAtom": {
              "actor": "",
              "on_enter": [
                {
                  "op": "mcp_call",
                  "args": {
                    "server": "blackbox",
                    "tool": "atom_invoke",
                    "arguments": {
                      "atom": "${vars.atom_request.atom_ref}",
                      "args": "${vars.atom_request.args}",
                      "project_dir": "${vars.project_dir}",
                      "owner": "workflow:${meta.arc_id}"
                    },
                    "timeout_secs": 120
                  },
                  "into_var": "atom_handle",
                  "on_failure": "halt"
                }
              ],
              "next": {
                "type": "goto",
                "to": "WaitAtom"
              }
            },
            "WaitAtom": {
              "actor": "",
              "on_enter": [
                {
                  "op": "mcp_call",
                  "args": {
                    "server": "blackbox",
                    "tool": "bro_wait",
                    "arguments": {
                      "task_id": "${vars.atom_handle.task_id}",
                      "timeout_seconds": 900
                    },
                    "timeout_secs": 920
                  },
                  "into_var": "atom_wait",
                  "on_failure": "halt"
                },
                {
                  "op": "mcp_call",
                  "args": {
                    "server": "blackbox",
                    "tool": "atom_status",
                    "arguments": {
                      "invocation_id": "${vars.atom_handle.invocation_id}",
                      "owner": "workflow:${meta.arc_id}"
                    },
                    "timeout_secs": 30
                  },
                  "into_var": "atom_status",
                  "on_failure": "halt"
                },
                {
                  "op": "set_var",
                  "args": {
                    "key": "atom_result",
                    "value": "${vars.atom_status}"
                  }
                }
              ],
              "next": {
                "type": "terminal"
              }
            }
          }
        }
      },
      "next": {
        "type": "goto",
        "to": "BlindPost"
      }
    },
    "BlindPost": {
      "actor": "panel",
      "prompt": "Whiteboard board_id=${vars.whiteboard_id}. This is the BLIND round of a Rust architecture-pathology review.\n\nScope: ${vars.scope_filter}\nSurvey JSON: ${vars.survey_json}\nAtom result collection: ${vars.atom_results}\n\nPost exactly ONE blind whiteboard_post using your registered alias as agent_name (exactly one of: soundness, precision, economy, resilience, corroboration \u2014 never your brofile name, never whiteboard_register). Apply your lens's single question to the atom-produced diagnosis candidates: challenge the candidates your lens would reject, corroborate the ones it would keep with concrete evidence, and flag any real defect the atoms missed. Set target_file / target_location / finding_refs / severity where you can, so conflict detection can pair overlapping claims. Do not edit files. Do not transition the board.",
      "next": {
        "type": "goto",
        "to": "ValidateBlind"
      }
    },
    "ValidateBlind": {
      "actor": "",
      "gate": "domain:pathology-review/whiteboard-participation",
      "next": {
        "type": "branch",
        "cases": {
          "ready": "TransitionToValidate",
          "invalid": "BoardInvalid"
        },
        "default": "BoardInvalid"
      },
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_summarize",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}"
            },
            "timeout_secs": 30
          },
          "into_var": "board_check",
          "on_failure": "halt"
        }
      ]
    },
    "TransitionToValidate": {
      "actor": "",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}",
              "target_phase": "read",
              "summary": "Blind lens diagnoses posted; making them visible for validation."
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}",
              "target_phase": "validate",
              "summary": "Read phase opened; dispatching the independent validator to trace each claim."
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        }
      ],
      "next": {
        "type": "goto",
        "to": "Validate"
      }
    },
    "Validate": {
      "actor": "validator",
      "prompt": "Whiteboard board_id=${vars.whiteboard_id}. VALIDATE phase. You are the independent evidence-prover. Read the lens posts with whiteboard_state / whiteboard_summarize (agent_name=\"validator\"). Do NOT re-derive every finding from scratch \u2014 AUDIT each lens claim's cited evidence and authority/evidence grade, and SETTLE only the weak-but-consequential ones by running the single operation that proves or disproves the mechanism, bundling that evidence with bbox_bundle_evidence and keeping the bundle id. Work ONE finding at a time and post its verdict before moving to the next: whiteboard_annotate(post_id=<post>, type=\"validation\", result=\"confirmed\"|\"refuted\"|\"inconclusive\") with a one-line basis and the evidence bundle id in the body. confirmed = the claim holds and its grade is honest; refuted = the audit or settling operation shows it false or its certainty unsupported (refuted posts are EXCLUDED from the plan, so refute only on evidence); inconclusive = you cannot settle it \u2014 default when unsure. Every surviving post must receive exactly one validation. Do not post proposals, vote, transition, or edit files.",
      "next": {
        "type": "goto",
        "to": "ValidateValidation"
      }
    },
    "ValidateValidation": {
      "actor": "",
      "gate": "domain:pathology-review/whiteboard-participation",
      "next": {
        "type": "branch",
        "cases": {
          "ready_debate": "TransitionToDebate",
          "ready_skip": "TransitionToResolve",
          "invalid": "BoardInvalid"
        },
        "default": "BoardInvalid"
      },
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_summarize",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}"
            },
            "timeout_secs": 30
          },
          "into_var": "board_check",
          "on_failure": "halt"
        }
      ]
    },
    "TransitionToDebate": {
      "actor": "",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}",
              "target_phase": "debate",
              "summary": "Validation complete and conflicts detected; opening targeted debate."
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        }
      ],
      "next": {
        "type": "goto",
        "to": "Debate"
      }
    },
    "Debate": {
      "actor": "panel",
      "prompt": "Whiteboard board_id=${vars.whiteboard_id}. This is the DEBATE phase. Read whiteboard_conflicts and whiteboard_state using your alias (soundness/precision/economy/resilience/corroboration). Engage the SPECIFIC posts you conflict with: raise a `challenge` only for a substantive objection that should change or drop the finding, and `corroborate` a post you independently agree with. Every surviving (non-refuted) post must receive at least one cross-agent challenge or corroborate, and cast at least one vote. Do NOT manufacture resolutions to clear the board: leave a genuine disagreement as an unresolved challenge \u2014 it will be carried into the plan as a Contradiction Requiring Human Judgment. Only resolve a challenge (resolves=<id>) when the post owner genuinely concedes it. Do not register, use brofile names, transition, or edit files.",
      "next": {
        "type": "goto",
        "to": "ValidateDebate"
      }
    },
    "ValidateDebate": {
      "actor": "",
      "gate": "domain:pathology-review/whiteboard-participation",
      "next": {
        "type": "branch",
        "cases": {
          "ready": "TransitionToResolve",
          "invalid": "Debate"
        },
        "default": "Debate"
      },
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_summarize",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}"
            },
            "timeout_secs": 30
          },
          "into_var": "board_check",
          "on_failure": "halt"
        }
      ]
    },
    "TransitionToResolve": {
      "actor": "",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}",
              "target_phase": "resolve",
              "summary": "Review complete; resolving board for correction-plan synthesis."
            },
            "timeout_secs": 30
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_summarize",
            "arguments": {
              "agent_name": "facilitator",
              "board_id": "${vars.whiteboard_id}"
            },
            "timeout_secs": 30
          },
          "into_var": "board_summary",
          "on_failure": "warn"
        }
      ],
      "next": {
        "type": "goto",
        "to": "Synthesize"
      }
    },
    "Synthesize": {
      "actor": "facilitator",
      "prompt": "Write the reviewed Rust Architecture Correction Plan payload as strict JSON. Do not write files; the workflow writes markdown after parsing your JSON.\n\nProject: ${vars.project_dir}\nScope: ${vars.scope_filter}\nBaseline commit stdout: ${vars.baseline_result.stdout}\nTarget context window: ${vars.target_context_window}\nSurvey JSON: ${vars.survey_json}\nAtom results: ${vars.atom_results}\nBoard summary JSON: ${vars.board_summary}\n\nRead the resolved board with whiteboard_state / whiteboard_conflicts (agent_name=\"facilitator\"). board_summary.surviving_post_ids are the posts the validator did NOT refute; board_summary.excluded_post_ids were refuted and MUST NOT appear in remediation slices. Build the plan from surviving posts only. Carry every still-unresolved challenge on a surviving post into `contradictions` (each {title, tension}); cap and flag inconclusive findings. Put every refuted post into `refuted_findings` (each {title, trace} where trace is the validator's reasoning). The Atom Mapping section must label every slice with a shipped atom, a G-series gap ID, or PD-manual. Operator-authority flags (acknowledge_repr, acknowledge_public_api_change) must be surfaced as gates, never assumed.\n\nReturn strict JSON only with keys: slug, title, brief, diagnosis_summary, evidence, authority_grades, atom_mapping, remediation_plan, acceptance_criteria, contradictions, refuted_findings, deferred. Markdown strings are allowed in the prose keys; contradictions and refuted_findings are arrays of objects. First byte {, final byte }.",
      "on_exit": [
        {
          "op": "parse_json",
          "args": {
            "from": "${Synthesize.output}",
            "repair_missing_closing_delimiters": true
          },
          "into_var": "plan_json",
          "on_failure": "halt"
        }
      ],
      "next": {
        "type": "goto",
        "to": "WritePlan"
      }
    },
    "WritePlan": {
      "actor": "",
      "on_enter": [
        {
          "op": "write_arch_pathology_plan",
          "args": {
            "project_dir": "${vars.project_dir}",
            "slug": "${vars.plan_json.slug}",
            "scope": "${vars.scope_filter}",
            "baseline_commit": "${vars.baseline_result.stdout}",
            "target_context_window": "${vars.target_context_window}",
            "generated_by": "rust-arch-pathology",
            "criteria_prefix": "RAP",
            "plan": "${vars.plan_json}"
          },
          "into_var": "write_result",
          "on_failure": "halt"
        }
      ],
      "next": {
        "type": "terminal"
      }
    },
    "BoardInvalid": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "board_check": "${vars.board_check}",
              "error": "whiteboard_participation_invalid"
            }
          }
        }
      ],
      "next": {
        "type": "terminal"
      }
    }
  }
}
