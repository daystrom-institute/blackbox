{
  "name": "atom-echo-review",
  "version": 1,
  "actors": {},
  "vars_schema": {
    "message": { "kind": "string", "required": true }
  },
  "atom_bindings": {
    "echo": {
      "atom_ref": "atom:echo@v1",
      "limits": {
        "writes_files": false,
        "dispatches_runs": 0,
        "max_depth": 0,
        "uses_network": false
      }
    }
  },
  "nodes": {
    "Echo": {
      "atom": "echo",
      "atom_args": { "message": "${vars.message}" },
      "next": { "type": "terminal" }
    }
  },
  "start": "Echo"
}
