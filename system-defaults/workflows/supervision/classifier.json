{
  "name": "supervision-classifier",
  "version": 1,
  "vars_schema": {
    "primary_invocation_id": { "kind": "string", "required": true },
    "attempt": { "kind": "int" },
    "tail_policy": { "kind": "object" },
    "alerting_classifications": { "kind": "array" },
    "poll_count": { "kind": "int" },
    "snapshot": { "kind": "any" },
    "classifier_result": { "kind": "object" }
  },
  "actors": {
    "classifier": {
      "kind": "executor",
      "brofile": "supervision-classifier-persona",
      "durable": false
    }
  },
  "start": "PollAttachedInvocation",
  "nodes": {
    "PollAttachedInvocation": {
      "actor": "",
      "on_enter": [
        {
          "op": "inc_var",
          "args": { "key": "poll_count", "by": 1, "initial": 0 }
        },
        {
          "op": "poll_attached_invocation",
          "args": {
            "primary_invocation_id": "${vars.primary_invocation_id}",
            "attempt": "${vars.attempt}",
            "tail_policy": "${vars.tail_policy}"
          },
          "into_var": "snapshot"
        }
      ],
      "next": { "type": "goto", "to": "ClassifySnapshot" }
    },
    "ClassifySnapshot": {
      "actor": "classifier",
      "prompt": "Classify this supervised invocation snapshot. Return strict JSON only with this shape: {\"classification\":\"nominal|stalled|off_task|needs_steer|uncertain|classifier_failed\",\"confidence\":0.0,\"summary\":\"...\",\"alert_source_key\":\"...\",\"evidence\":[\"...\"]}. Treat alerting_classifications=${vars.alerting_classifications}. Snapshot JSON: ${vars.snapshot}",
      "on_exit": [
        {
          "op": "set_var",
          "args": {
            "key": "classifier_result",
            "value": {
              "classification": "classifier_failed",
              "confidence": 0,
              "summary": "classifier output could not be parsed",
              "alert_source_key": "classifier_parse_failed",
              "evidence": []
            }
          }
        },
        {
          "op": "parse_json",
          "args": { "from": "${ClassifySnapshot.output}" },
          "into_var": "classifier_result",
          "on_failure": "warn"
        }
      ],
      "gate": "domain:supervision/classifier-route",
      "next": {
        "type": "branch",
        "cases": {
          "alert": "ExitAlert",
          "poll_again": "Sleep",
          "no_alert": "ExitNoAlert",
          "classifier_failed": "ExitClassifierFailed"
        },
        "default": "ExitClassifierFailed"
      }
    },
    "Sleep": {
      "sleep": { "duration_ms": 1000 },
      "next": { "type": "goto", "to": "PollAttachedInvocation" }
    },
    "ExitNoAlert": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "status": "no_alert",
              "classification": "${vars.classifier_result.classification}",
              "confidence": "${vars.classifier_result.confidence}",
              "summary": "${vars.classifier_result.summary}",
              "alert_source_key": "${vars.classifier_result.alert_source_key}",
              "evidence": "${vars.classifier_result.evidence}",
              "attempt_metadata": "${vars.snapshot.attempt_metadata}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    },
    "ExitAlert": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "status": "alert",
              "classification": "${vars.classifier_result.classification}",
              "confidence": "${vars.classifier_result.confidence}",
              "summary": "${vars.classifier_result.summary}",
              "alert_source_key": "${vars.classifier_result.alert_source_key}",
              "evidence": "${vars.classifier_result.evidence}",
              "attempt_metadata": "${vars.snapshot.attempt_metadata}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    },
    "ExitClassifierFailed": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "status": "classifier_failed",
              "classification": "classifier_failed",
              "confidence": 0,
              "summary": "classifier output could not be validated",
              "alert_source_key": "classifier_failed",
              "evidence": [],
              "attempt_metadata": "${vars.snapshot.attempt_metadata}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
