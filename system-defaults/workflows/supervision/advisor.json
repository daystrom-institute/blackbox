{
  "name": "supervision-advisor",
  "version": 1,
  "vars_schema": {
    "primary_invocation_id": { "kind": "string", "required": true },
    "attempt": { "kind": "int" },
    "tail_policy": { "kind": "object" },
    "classifier_findings": { "kind": "array" },
    "acceptance_criteria": { "kind": "string", "required": true },
    "attempt_history": { "kind": "array" },
    "allowed_actions": { "kind": "array" },
    "recovery_policy": { "kind": "object" },
    "snapshot": { "kind": "any" },
    "advisor_action": { "kind": "object" },
    "action_result": { "kind": "object" }
  },
  "actors": {
    "advisor": {
      "kind": "executor",
      "brofile": "supervision-advisor-persona",
      "durable": true
    }
  },
  "start": "PollPrimary",
  "nodes": {
    "PollPrimary": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "action_result",
            "value": {}
          }
        },
        {
          "op": "poll_attached_invocation",
          "args": {
            "primary_invocation_id": "${vars.primary_invocation_id}",
            "attempt": "${vars.attempt}",
            "tail_policy": "${vars.tail_policy}"
          },
          "into_var": "snapshot"
        }
      ],
      "next": { "type": "goto", "to": "Judge" }
    },
    "Judge": {
      "actor": "advisor",
      "prompt": "Judge this supervised invocation. Acceptance criteria: ${vars.acceptance_criteria}. Allowed actions: ${vars.allowed_actions}. Recovery policy: ${vars.recovery_policy}. Attempt history: ${vars.attempt_history}. Classifier findings, possibly empty: ${vars.classifier_findings}. Primary snapshot: ${vars.snapshot}. Return strict JSON only: {\"action\":\"accept|continue_observing|steer_primary|cancel_and_retry|replace_primary|escalate_human|bail\",\"reason\":\"...\",\"confidence\":0.0,\"prompt\":\"required only for steer_primary\",\"evidence_keys\":[\"...\"],\"checkpoint\":{}}.",
      "on_exit": [
        {
          "op": "set_var",
          "args": {
            "key": "advisor_action",
            "value": {
              "action": "bail",
              "reason": "advisor output could not be parsed",
              "confidence": 0,
              "evidence_keys": ["advisor_parse_failed"]
            }
          }
        },
        {
          "op": "parse_json",
          "args": { "from": "${Judge.output}" },
          "into_var": "advisor_action",
          "on_failure": "warn"
        }
      ],
      "gate": "domain:supervision/advisor-action-route",
      "next": {
        "type": "branch",
        "cases": {
          "accept": "ExitAction",
          "continue_observing": "ExitAction",
          "steer_primary": "ExecuteAction",
          "cancel_and_retry": "ExecuteAction",
          "replace_primary": "ExecuteAction",
          "escalate_human": "ExitAction",
          "bail": "ExitAction",
          "invalid_action": "ExitInvalidAction"
        },
        "default": "ExitInvalidAction"
      }
    },
    "ExecuteAction": {
      "actor": "",
      "on_enter": [
        {
          "op": "execute_supervision_action",
          "args": {
            "primary_invocation_id": "${vars.primary_invocation_id}",
            "attempt": "${vars.attempt}",
            "action": "${vars.advisor_action}",
            "max_attempts": "${vars.recovery_policy.max_attempts}"
          },
          "into_var": "action_result"
        }
      ],
      "next": { "type": "goto", "to": "ExitAction" }
    },
    "ExitAction": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "action": "${vars.advisor_action.action}",
              "reason": "${vars.advisor_action.reason}",
              "confidence": "${vars.advisor_action.confidence}",
              "evidence_keys": "${vars.advisor_action.evidence_keys}",
              "checkpoint": {
                "primary": "${vars.snapshot.attempt_metadata}",
                "classifier_findings": "${vars.classifier_findings}",
                "action_result": "${vars.action_result}"
              }
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    },
    "ExitInvalidAction": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "action": "bail",
              "reason": "advisor output failed action validation",
              "confidence": 0,
              "evidence_keys": ["invalid_advisor_action"],
              "checkpoint": {
                "primary": "${vars.snapshot.attempt_metadata}",
                "raw_action": "${vars.advisor_action}"
              }
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
