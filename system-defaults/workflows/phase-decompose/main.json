{
  "name": "phase-decompose-main",
  "version": 1,
  "policy_packet": "domain:workflow-policy/arc-budget",
  "vars_schema": {
    "phase_doc_path": { "kind": "string", "required": true },
    "phase_doc_text": { "kind": "string", "required": true },
    "project_dir": { "kind": "string", "required": true },
    "target_context_window": { "kind": "int", "required": true },
    "acceptance_criteria": { "kind": "array", "required": true },
    "epoch": { "kind": "int" },
    "max_epochs": { "kind": "int" },
    "epoch_check": { "kind": "object" },
    "epoch_status": { "kind": "string" },
    "evidence_bundle": { "kind": "object" },
    "triage_verdict": { "kind": "string" },
    "implementation_output": { "kind": "object" },
    "advisor_verdict": { "kind": "string" },
    "acceptance_status": { "kind": "string" },
    "dag": { "kind": "object" },
    "sub_results": { "kind": "array" },
    "recompose_verdict": { "kind": "string" },
    "remediation_packet": { "kind": "object" }
  },
  "actors": {},
  "start": "InitEpoch",
  "nodes": {
    "InitEpoch": {
      "actor": "",
      "on_enter": [
        {
          "op": "inc_var",
          "args": {
            "key": "epoch",
            "by": 0
          }
        }
      ],
      "next": { "type": "goto", "to": "Discovery" }
    },
    "Discovery": {
      "actor": "",
      "subworkflow_ref": "phase-decompose-discovery",
      "imports": [
        "phase_doc_path",
        "phase_doc_text",
        "project_dir",
        "target_context_window",
        "acceptance_criteria"
      ],
      "exports": ["evidence_bundle", "triage_verdict"],
      "next": { "type": "goto", "to": "TriageGate" }
    },
    "TriageGate": {
      "actor": "",
      "gate": "domain:phase-decompose/triage",
      "prompt": "triage_verdict=${vars.triage_verdict}",
      "next": {
        "type": "branch",
        "cases": {
          "fit_direct": "DirectImplement",
          "needs_decompose": "Decompose"
        },
        "default": "Decompose"
      }
    },
    "DirectImplement": {
      "actor": "",
      "subworkflow_ref": "phase-decompose-supervised-impl",
      "imports": [
        "phase_doc_path",
        "phase_doc_text",
        "project_dir",
        "evidence_bundle",
        "acceptance_criteria"
      ],
      "exports": ["implementation_output", "advisor_verdict", "acceptance_status"],
      "next": { "type": "goto", "to": "DirectDone" }
    },
    "DirectDone": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "path": "fit_direct",
              "triage_verdict": "${vars.triage_verdict}",
              "evidence_bundle": "${vars.evidence_bundle}",
              "implementation_output": "${vars.implementation_output}",
              "advisor_verdict": "${vars.advisor_verdict}",
              "acceptance_status": "${vars.acceptance_status}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    },
    "Decompose": {
      "actor": "",
      "subworkflow_ref": "phase-decompose-ensemble-decompose",
      "imports": [
        "phase_doc_path",
        "phase_doc_text",
        "project_dir",
        "evidence_bundle",
        "acceptance_criteria",
        "target_context_window"
      ],
      "exports": ["dag"],
      "next": { "type": "goto", "to": "ImplementSubUnits" }
    },
    "ImplementSubUnits": {
      "actor": "",
      "foreach": {
        "items": "${vars.dag.sub_units}",
        "as_var": "sub_unit",
        "index_as": "sub_unit_index",
        "key": "${vars.sub_unit.sub_unit_id}",
        "imports": [
          "phase_doc_path",
          "phase_doc_text",
          "project_dir",
          "evidence_bundle",
          "acceptance_criteria"
        ],
        "exports": ["implementation_output", "advisor_verdict", "acceptance_status"],
        "parallelism": 2,
        "on_item_failure": "collect_then_halt",
        "collect": { "into_var": "sub_results" },
        "subworkflow_ref": "phase-decompose-supervised-impl"
      },
      "next": { "type": "goto", "to": "Recompose" }
    },
    "Recompose": {
      "actor": "",
      "subworkflow_ref": "phase-decompose-recompose",
      "imports": [
        "phase_doc_path",
        "phase_doc_text",
        "project_dir",
        "acceptance_criteria",
        "dag",
        "sub_results",
        "epoch",
        "max_epochs"
      ],
      "exports": ["recompose_verdict", "remediation_packet"],
      "next": { "type": "goto", "to": "RecomposeGate" }
    },
    "RecomposeGate": {
      "actor": "",
      "gate": "domain:phase-decompose/recompose-verdict",
      "prompt": "recompose_verdict=${vars.recompose_verdict}",
      "next": {
        "type": "branch",
        "cases": {
          "satisfied": "Done",
          "work_remains": "EpochGate",
          "untenable": "Halt"
        },
        "default": "EpochGate"
      }
    },
    "EpochGate": {
      "actor": "",
      "on_enter": [
        {
          "op": "shell",
          "args": {
            "argv": [
              "python3",
              "system-defaults/phase-decompose/scripts/epoch-check.py",
              "--epoch=${vars.epoch}",
              "--max-epochs=${vars.max_epochs}"
            ],
            "cwd": "${vars.project_dir}"
          },
          "into_var": "epoch_check",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": {
            "key": "epoch_status",
            "value": "${vars.epoch_check.parsed.status}"
          }
        }
      ],
      "gate": "domain:phase-decompose/epoch-ceiling",
      "prompt": "epoch_status=${vars.epoch_status} epoch=${vars.epoch} max_epochs=${vars.max_epochs}",
      "next": {
        "type": "branch",
        "cases": {
          "continue": "PrepareRemediation",
          "halt": "Halt"
        },
        "default": "Halt"
      }
    },
    "PrepareRemediation": {
      "actor": "",
      "on_enter": [
        {
          "op": "inc_var",
          "args": {
            "key": "epoch",
            "by": 1
          }
        },
        {
          "op": "set_var",
          "args": {
            "key": "phase_doc_text",
            "value": "${vars.remediation_packet.phase_doc_text}"
          }
        }
      ],
      "next": { "type": "goto", "to": "Discovery" }
    },
    "Done": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "path": "decomposed",
              "triage_verdict": "${vars.triage_verdict}",
              "dag": "${vars.dag}",
              "sub_results": "${vars.sub_results}",
              "recompose_verdict": "${vars.recompose_verdict}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    },
    "Halt": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "path": "halt",
              "triage_verdict": "${vars.triage_verdict}",
              "recompose_verdict": "${vars.recompose_verdict}",
              "remediation_packet": "${vars.remediation_packet}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
