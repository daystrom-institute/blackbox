{
  "name": "phase-decompose-supervised-impl",
  "version": 2,
  "vars_schema": {
    "phase_doc_path": { "kind": "string", "required": true },
    "phase_doc_text": { "kind": "string", "required": true },
    "project_dir": { "kind": "string", "required": true },
    "evidence_bundle": { "kind": "object" },
    "acceptance_criteria": { "kind": "array" },
    "sub_unit": { "kind": "object" },
    "implementation_output": { "kind": "object" },
    "advisor_output": { "kind": "object" },
    "advisor_verdict": { "kind": "string" },
    "acceptance_status": { "kind": "string" }
  },
  "actors": {
    "implementer": {
      "kind": "executor",
      "brofile": "phase-decomposer-implementer",
      "durable": false
    },
    "advisor": {
      "kind": "executor",
      "brofile": "phase-decomposer-acceptance-advisor",
      "durable": false
    }
  },
  "start": "InitDefaults",
  "nodes": {
    "InitDefaults": {
      "actor": "",
      "on_enter": [
        {
          "op": "default_var",
          "args": {
            "key": "sub_unit",
            "value": {}
          }
        }
      ],
      "next": { "type": "goto", "to": "Implement" }
    },
    "Implement": {
      "actor": "implementer",
      "prompt": "Project: ${vars.project_dir}\nPhase doc path: ${vars.phase_doc_path}\nPhase doc text, when present:\n${vars.phase_doc_text}\n\nEvidence bundle JSON:\n${vars.evidence_bundle}\n\nParent acceptance criteria JSON:\n${vars.acceptance_criteria}\n\nSub-unit JSON, when present:\n${vars.sub_unit}\n\nExecute only this bounded assignment. If this is a live-test/no-edit phase, do not edit files. Otherwise implement and validate normally. Return strict JSON only: {\"status\":\"completed|blocked|failed\",\"summary\":\"...\",\"files_touched\":[],\"validation\":[],\"acceptance_ids\":[\"...\"],\"residual_risk\":\"...\"}.",
      "on_exit": [
        {
          "op": "parse_json",
          "args": { "from": "${Implement.output}" },
          "into_var": "implementation_output",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "Advisor" }
    },
    "Advisor": {
      "actor": "advisor",
      "prompt": "Project: ${vars.project_dir}\nEvidence bundle JSON:\n${vars.evidence_bundle}\nAcceptance criteria JSON:\n${vars.acceptance_criteria}\nSub-unit JSON:\n${vars.sub_unit}\nImplementer strict JSON:\n${vars.implementation_output}\n\nJudge whether the assignment is complete. Return strict JSON only: {\"advisor_verdict\":\"accept|remediate|halt\",\"acceptance_status\":\"passed|failed|blocked\",\"summary\":\"...\",\"failed_acceptance_ids\":[],\"steer_prompt\":\"...\"}.",
      "on_exit": [
        {
          "op": "parse_json",
          "args": { "from": "${Advisor.output}" },
          "into_var": "advisor_output",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": {
            "key": "advisor_verdict",
            "value": "${vars.advisor_output.advisor_verdict}"
          }
        },
        {
          "op": "set_var",
          "args": {
            "key": "acceptance_status",
            "value": "${vars.advisor_output.acceptance_status}"
          }
        }
      ],
      "next": { "type": "goto", "to": "ExportOutcome" }
    },
    "ExportOutcome": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": {
            "key": "_structured_exit",
            "value": {
              "implementation_output": "${vars.implementation_output}",
              "advisor_verdict": "${vars.advisor_verdict}",
              "acceptance_status": "${vars.acceptance_status}",
              "advisor_output": "${vars.advisor_output}"
            }
          }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
