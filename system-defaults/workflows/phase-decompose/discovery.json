{
  "name": "phase-decompose-discovery",
  "version": 8,
  "vars_schema": {
    "phase_doc_path": { "kind": "string", "required": true },
    "phase_doc_text": { "kind": "string", "required": true },
    "project_dir": { "kind": "string", "required": true },
    "target_context_window": { "kind": "int", "required": true },
    "acceptance_criteria": { "kind": "array" },
    "question_shape_extract": { "kind": "object" },
    "question_shapes": { "kind": "array" },
    "scout_results": { "kind": "array" },
    "inlet_result": { "kind": "object" },
    "evidence_bundle": { "kind": "object" },
    "triage_verdict": { "kind": "string" }
  },
  "actors": {
    "inlet": {
      "kind": "executor",
      "brofile": "phase-decomposer-inlet",
      "durable": true,
      "compaction_anchor": true
    }
  },
  "start": "ParseQuestionShapes",
  "nodes": {
    "ParseQuestionShapes": {
      "actor": "",
      "on_enter": [
        {
          "op": "shell",
          "args": {
            "argv": [
              "python3",
              "system-defaults/phase-decompose/scripts/extract-question-shapes.py",
              "--path",
              "${vars.phase_doc_path}",
              "--text",
              "${vars.phase_doc_text}"
            ],
            "cwd": "${vars.project_dir}"
          },
          "into_var": "question_shape_extract",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": {
            "key": "question_shapes",
            "value": "${vars.question_shape_extract.parsed}"
          }
        }
      ],
      "next": { "type": "goto", "to": "ScoutEach" }
    },
    "ScoutEach": {
      "actor": "",
      "foreach": {
        "items": "${vars.question_shapes}",
        "as_var": "question_shape",
        "index_as": "question_index",
        "key": "shape-${vars.question_index}",
        "imports": ["project_dir"],
        "exports": ["scout_json"],
        "parallelism": 3,
        "on_item_failure": "collect_then_halt",
        "collect": { "into_var": "scout_results" },
        "subworkflow": {
          "name": "phase-decompose-scout-child",
          "version": 1,
          "vars_schema": {
            "project_dir": { "kind": "string", "required": true },
            "question_shape": { "kind": "object", "required": true },
            "question_index": { "kind": "int" },
            "scout_handle": { "kind": "object" },
            "scout_wait": { "kind": "object" },
          "scout_json": { "kind": "object" }
          },
          "actors": {},
          "start": "DispatchScout",
          "nodes": {
            "DispatchScout": {
              "actor": "",
              "on_enter": [
                {
                  "op": "mcp_call",
                  "args": {
                    "server": "blackbox",
                    "tool": "bro_agent_dispatch",
                    "arguments": {
                      "agent": "corpus-pathfinder",
                      "project_dir": "${vars.project_dir}",
                      "args": {
                        "question_shape": "${vars.question_shape.question_shape}",
                        "query": "${vars.question_shape.query}",
                        "project_dir": "${vars.project_dir}",
                        "scope_hint": "${vars.question_shape.scope_hint}",
                        "known_evidence": "${vars.question_shape.known_evidence}"
                      }
                    },
                    "timeout_secs": 120
                  },
                  "into_var": "scout_handle",
                  "on_failure": "halt"
                }
              ],
              "next": { "type": "goto", "to": "WaitScout" }
            },
            "WaitScout": {
              "actor": "",
              "on_enter": [
                {
                  "op": "mcp_call",
                  "args": {
                    "server": "blackbox",
                    "tool": "bro_wait",
                    "arguments": {
                      "task_id": "${vars.scout_handle.task_id}",
                      "timeout_seconds": 600
                    },
                    "timeout_secs": 610
                  },
                  "into_var": "scout_wait",
                  "on_failure": "halt"
                },
                {
                  "op": "parse_json",
                  "args": { "from": "${vars.scout_wait.result}" },
                  "into_var": "scout_json",
                  "on_failure": "halt"
                }
              ],
              "next": { "type": "terminal" }
            }
          }
        }
      },
      "next": { "type": "goto", "to": "Inlet" }
    },
    "Inlet": {
      "actor": "inlet",
      "prompt": "Phase doc path: ${vars.phase_doc_path}\nProject: ${vars.project_dir}\nTarget context window bytes: ${vars.target_context_window}\nAcceptance criteria JSON: ${vars.acceptance_criteria}\n\nScout fanout results JSON:\n${vars.scout_results}\n\nAggregate only the scout evidence. Extract refs from each item.exports.scout_json.leads_entity_refs[*].ref and item.exports.scout_json.leads_symbols_files[*].entity_ref. Preserve path ids from leads_paths[*].path_id and bundle handles. Call bbox_ref_size(refs=[...]) on the unique refs. Then make no more tool calls. Return one complete compact JSON object only with exactly two top-level keys. Minimal example: {\"triage_verdict\":\"needs_decompose\",\"evidence_bundle\":{\"total_bytes\":123,\"target_context_window\":1000,\"refs\":[],\"knowledge_ids\":[],\"path_ids\":[],\"scout_summaries\":[],\"degraded\":{\"unresolved_refs\":[],\"omitted_refs\":0}}}. The final three characters of your response must be }}}. Do not include rationale or any other top-level key. Keep degraded.unresolved_refs to at most five examples. Do not use markdown fences. Do not construct or mention a DAG.",
      "on_exit": [
        {
          "op": "parse_json",
          "args": { "from": "${Inlet.output}" },
          "into_var": "inlet_result",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": {
            "key": "evidence_bundle",
            "value": "${vars.inlet_result.evidence_bundle}"
          }
        },
        {
          "op": "set_var",
          "args": {
            "key": "triage_verdict",
            "value": "${vars.inlet_result.triage_verdict}"
          }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
