{
  "_contract": "atom/v1",
  "kind": "atom",
  "name": "validate-schema",
  "version": 1,
  "subcontract": "utility/v1",
  "manifest": {
    "description": "Classify whether the invocation input is a JSON object and echo the typed result.",
    "when_to_use": [
      "checking deterministic atom output-shape validation",
      "testing atom_status on a terminal invocation",
      "using a cheap guard atom in workflow examples"
    ],
    "anti_patterns": [
      "do not use as a full JSON Schema validator",
      "do not use for inputs whose exact schema matters"
    ],
    "inputs": {
      "schema": {}
    },
    "outputs": {
      "schema": {
        "type": "object",
        "required": ["valid", "type", "input"],
        "properties": {
          "valid": { "type": "boolean" },
          "type": { "type": "string" },
          "input": {}
        },
        "additionalProperties": false
      },
      "evidence_density": "low"
    },
    "effects": {
      "writes_files": false,
      "dispatches_runs": 0,
      "max_depth": 0,
      "uses_network": false
    },
    "composition": {
      "may_invoke_atoms": { "kind": "none" }
    },
    "implementation": {
      "kind": "deterministic",
      "runner": "validate-schema"
    },
    "trace": {
      "retain": "summary",
      "portal_focus": "on_request"
    },
    "cost_class": "cheap",
    "provenance": {
      "kind": "hand_authored",
      "author": "blackbox-system-defaults",
      "created_at": "2026-05-13T00:00:00Z"
    }
  }
}
