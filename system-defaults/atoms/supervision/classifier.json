{
  "_contract": "atom/v1",
  "kind": "atom",
  "name": "supervision-classifier",
  "version": 1,
  "subcontract": "supervision/classifier/v1",
  "manifest": {
    "description": "Workflow-backed read-only classifier for attached supervised atom invocations.",
    "when_to_use": [
      "observing a supervised primary invocation through an attachment snapshot",
      "classifying mechanical and semantic supervision evidence without mutating the primary",
      "running cheap classifier-only supervision before advisor judgment"
    ],
    "anti_patterns": [
      "do not use to steer or cancel the primary directly",
      "do not use without a wrapper-owned supervision attachment",
      "do not use for final acceptance decisions that require advisor judgment"
    ],
    "inputs": {
      "schema": {
        "type": "object",
        "required": ["primary_invocation_id"],
        "properties": {
          "primary_invocation_id": { "type": "string" },
          "attempt": { "type": "integer", "minimum": 1 },
          "tail_policy": { "type": "object" },
          "alerting_classifications": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "schema": {
        "type": "object",
        "required": ["status", "classification", "evidence"],
        "properties": {
          "status": { "enum": ["no_alert", "alert", "classifier_failed"] },
          "classification": {
            "enum": ["nominal", "stalled", "off_task", "needs_steer", "uncertain", "classifier_failed"]
          },
          "confidence": { "type": "number" },
          "summary": { "type": "string" },
          "alert_source_key": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "attempt_metadata": { "type": "object" }
        },
        "additionalProperties": true
      },
      "evidence_density": "medium"
    },
    "effects": {
      "writes_files": false,
      "dispatches_runs": 1,
      "max_depth": 1,
      "uses_network": false
    },
    "composition": {
      "may_invoke_atoms": { "kind": "none" }
    },
    "implementation": {
      "kind": "workflow",
      "workflow_ref": "workflow:supervision-classifier@v1"
    },
    "trace": {
      "retain": "summary",
      "portal_focus": "on_attention"
    },
    "cost_class": "cheap",
    "provenance": {
      "kind": "hand_authored",
      "author": "blackbox-system-defaults",
      "created_at": "2026-05-14T00:00:00Z"
    }
  }
}
