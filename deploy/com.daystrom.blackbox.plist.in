<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daystrom.blackbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/blackboxd</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>BLACKBOX_RUNTIME_ROLE</key>
    <string>corpus</string>
    <key>BLACKBOX_SERVICE_TOKEN_FILE</key>
    <string>__HOME__/.local/state/blackbox/service.token</string>
    <key>BLACKBOX_FLEET_TRANSCRIPT_ROOT</key>
    <string>__HOME__/.local/state/blackbox/fleetd/workers</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/blackboxd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/blackboxd.log</string>
</dict>
</plist>
