[Unit]
Description=blackbox MCP daemon — transcript search, knowledge store, orchestration
After=network.target
# Ensure blackbox starts cleanly — old bro.service occupied port 7263 (now retired).

[Service]
Type=simple
ExecStart=%h/.local/bin/blackboxd
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=blackbox=info
# Main config defaults to %h/.config/blackbox/config.toml.
# Use BLACKBOX_CONFIG only when this unit must point at a non-default file.
# Environment=BLACKBOX_CONFIG=%h/.config/blackbox/config.toml
# Optional systemd secret injection:
# LoadCredential=voyage-api-key:%h/.local/share/blackbox/secrets/voyage-api-key
# blackbox-owned state defaults to XDG paths under ~/.local/{state,share}.
WorkingDirectory=%h
# Keep stderr/stdout in journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
