[Unit]
Description=blackbox MCP daemon — transcript search, knowledge store, orchestration
After=network.target
# Ensure blackbox starts cleanly — old bro.service occupied port 7263 (now retired).

[Service]
Type=simple
ExecStart=%h/.local/bin/blackboxd
Restart=on-failure
RestartSec=3
Environment=BBOX_PORT=7264
Environment=RUST_LOG=blackbox=info
# HTTP listener bind. Default 127.0.0.1 (loopback only — the daemon
# exposes broad MCP authority and webhook ingestion; never put it on
# a public interface). Set to 0.0.0.0 only if you need a Docker
# container on the same host to deliver webhooks
# (Forgejo/Gitea/Stripe → http://172.17.0.1:7264/webhook/...).
# Closed-network assumption applies in 0.0.0.0 mode.
Environment=BBOX_BIND=127.0.0.1
# blackbox-owned state defaults to XDG paths under ~/.local/{state,share}.
WorkingDirectory=%h
# Keep stderr/stdout in journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
