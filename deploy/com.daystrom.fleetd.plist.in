<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daystrom.fleetd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/fleetd</string>
    <string>--mode</string>
    <string>authority</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>FLEETD_STATE_DIR</key>
    <string>__HOME__/.local/state/blackbox/fleetd</string>
    <key>BLACKBOX_SERVICE_TOKEN_FILE</key>
    <string>__HOME__/.local/state/blackbox/service.token</string>
    <key>FLEETD_BRO_HARNESS_BIN</key>
    <string>__HOME__/.local/bin/bro-harness</string>
    <key>FLEETD_FLEET_CONFIG</key>
    <string>__HOME__/Library/Application Support/blackbox/fleet.json</string>
    <key>FLEETD_BLACKBOXD_URL</key>
    <string>http://127.0.0.1:7264</string>
    <key>FLEETD_BLACKOPSD_URL</key>
    <string>http://127.0.0.1:7266</string>
    <key>FLEETD_ALLOWED_CAPABILITIES</key>
    <string>corpus,blackops.agent,atom</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/fleetd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/fleetd.log</string>
</dict>
</plist>
