[Unit]
Description=blackbox Slack sidecar — Socket Mode event bridge
After=network.target blackbox.service
Wants=blackbox.service

[Service]
Type=simple
ExecStart=%h/.local/bin/bro-slack \
  --self-user-id ${SLACK_SELF_USER_ID} \
  --self-bot-id ${SLACK_SELF_BOT_ID} \
  --daemon-url http://127.0.0.1:${BBOX_PORT} \
  --webhook-name slack \
  --app-token-env SLACK_APP_TOKEN \
  --signing-secret-env SLACK_SIGNING_SECRET \
  --shared-secret-env BRO_SLACK_SHARED_SECRET \
  --identities-file %h/.bro/slack-identities.json \
  --health-port 7299 \
  --log-level info
Restart=on-failure
RestartSec=3
WorkingDirectory=%h
StandardOutput=journal
StandardError=journal

# ── Required environment ───────────────────────────────────────
# Set these in a drop-in at bro-slack.service.d/secrets.conf or
# via `systemctl --user set-environment`:
#
#   SLACK_APP_TOKEN=xapp-1-...       (Socket Mode app-level token)
#   SLACK_SELF_USER_ID=U...          (bot's U-prefix user id)
#   SLACK_SELF_BOT_ID=B...           (bot's B-prefix bot id)
#   BBOX_PORT=7264                   (daemon port, default 7264)
#
# ── Optional ───────────────────────────────────────────────────
#   SLACK_SIGNING_SECRET=...         (Events API; unused on Socket Mode)
#   BRO_SLACK_SHARED_SECRET=...      (HMAC key for sidecar→daemon; also
#                                     set in blackboxd env)
#
# Drop-in example (~/.config/systemd/user/bro-slack.service.d/secrets.conf):
#   [Service]
#   Environment=SLACK_APP_TOKEN=xapp-1-...
#   Environment=SLACK_SELF_USER_ID=U0BOTUSR0
#   Environment=SLACK_SELF_BOT_ID=B0BOTBOT0
#   Environment=BBOX_PORT=7264

[Install]
WantedBy=default.target
