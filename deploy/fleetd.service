[Unit]
Description=fleetd — per-machine blackbox fleet supervisor
After=network.target
# Deliberately NOT Requires=/Before= blackbox.service. fleetd starts its own
# workers on demand and blackboxd starts fleetd if the socket is absent, so an
# ordering dependency would only add a failure mode. This unit exists so
# fleetd is already up before the first dispatch and is restarted if it dies.

[Service]
Type=simple
ExecStart=%h/.local/bin/fleetd
Restart=always
RestartSec=3
Environment=RUST_LOG=fleetd=info
# The daemon dials fleetd in its BRO home: <bro_home>/fleetd.sock, with the
# shared-secret token at <bro_home>/fleetd.token. With no --state-dir, fleetd
# resolves that same dir from the environment the way the daemon does:
# $BRO_HOME, else $BLACKBOX_STATE_DIR/bro, else $XDG_STATE_HOME/blackbox/bro
# (absolute, not on macOS), else ~/.local/state/blackbox/bro. So this unit
# needs no --state-dir as long as it sees the daemon's environment. fleetd
# reads no daemon config file: a daemon whose paths.state_dir or
# paths.bro_home is set in its config file needs the matching explicit
# --state-dir here (see fleetd-dev.service).
WorkingDirectory=%h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
