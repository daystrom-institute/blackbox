[Unit]
Description=blackbox MCP daemon (dev) — isolated transcript search, knowledge store, orchestration
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/blackboxd-dev
Restart=on-failure
RestartSec=3
Environment=BBOX_PORT=7265
# HTTP listener bind. Defaults to 0.0.0.0 in dev so a Forgejo/Gitea
# Docker container on the same host can deliver webhooks via
# http://172.17.0.1:7265/webhook/<name>. Closed-network assumption.
# Switch to 127.0.0.1 if you don't need container ingress.
Environment=BBOX_BIND=0.0.0.0
Environment=BLACKBOX_MCP_NAME=blackbox-dev
Environment=BLACKBOX_STATE_DIR=%h/.local/state/blackbox-dev
Environment=BLACKBOX_KNOWLEDGE_PATH=%h/.local/state/blackbox-dev/blackbox-knowledge.json
Environment=BLACKBOX_THREADS_PATH=%h/.local/state/blackbox-dev/blackbox-threads.json
Environment=BLACKBOX_NOTES_PATH=%h/.local/state/blackbox-dev/blackbox-notes.json
Environment=TRANSCRIPT_SEARCH_INDEX_PATH=%h/.local/share/blackbox-dev/index
Environment=BRO_HOME=%h/.local/state/blackbox-dev/bro
Environment=BLACKBOX_GLOBAL_CLAUDE_MD=%h/.claude-shared/dev/CLAUDE.md
Environment=BLACKBOX_GLOBAL_CODEX_MD=%h/.claude-shared/dev/AGENTS.md
Environment=BLACKBOX_GLOBAL_GEMINI_MD=%h/.claude-shared/dev/GEMINI.md
Environment=BLACKBOX_BACKUP_DIR=%h/.local/state/blackbox-dev/backups
Environment=RUST_LOG=blackbox=info
WorkingDirectory=%h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
