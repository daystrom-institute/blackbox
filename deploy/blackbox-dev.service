[Unit]
Description=blackbox MCP daemon (dev) — isolated transcript search, knowledge store, orchestration
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/blackboxd-dev
Restart=on-failure
RestartSec=3
Environment=BLACKBOX_CONFIG=%h/.config/blackbox-dev/config.toml
Environment=RUST_LOG=blackbox=info
WorkingDirectory=%h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
