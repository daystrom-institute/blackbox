  "scope_note": "Names are exact MCP declarations. Retire removes the full tool; slim requires action/DTO review. Keep is architectural scope, not a passing audit verdict. Host paths and live installation payloads are excluded.",
  "groups": {
    "corpus_tool_history": {"disposition": "keep", "wave": "S3", "reason": "Retain indexed tool-call history as a corpus read, with bounded candidate pagination."},
    "bro_control": {
      "disposition": "slim",
      "wave": "S1",
      "reason": "Keep reliable bro control, routing, team membership and wait primitives; remove automatic advisor/continuation execution and legacy workflow admission coupling."
    },
    "agent_templates": {
      "disposition": "slim",
      "wave": "S1",
      "reason": "Keep named single-bro templates/discovery. Separate special adapters in S1; remove the Badgey adapter only after S2 stops its admission. Remove application evaluation/promotion loops."
    },
    "artifacts": {
      "disposition": "slim",
      "wave": "S4",
      "reason": "Keep installation for retained brofiles, simple agents, teams and policy packets; retire executable workflow/atom/cron kinds without breaking legacy receipt decoding."
    },
    "atoms": {
      "disposition": "retire",
      "wave": "S3",
      "reason": "Remove daemon atom discovery, invocation, delegation and supervision; preserve useful local operations directly in harness bindings."
    },
    "badgey": {
      "disposition": "retire",
      "wave": "S2",
      "reason": "Remove Badgey application orchestration and proposal lifecycle."
    },
    "consultant": {
      "disposition": "retire",
      "wave": "S2",
      "reason": "Badgey is the only registered consumer; remove its genericized application runtime as well."
    },
    "slack": {
      "disposition": "retire",
      "wave": "S2",
      "reason": "Remove bot bindings and proposal/thread linkage; preserve generic corpus and legacy record interpretation separately."
    },
    "workflows_triggers": {
      "disposition": "retire",
      "wave": "S3",
      "reason": "Remove daemon workflows, arcs, wait signals and configurable cron/poller/webhook routing after extracting essential maintenance operations."
    },
    "event_automation": {
      "disposition": "retire",
      "wave": "S4",
      "reason": "Remove general event/reaction/identity automation MCP surface; preserve required bro observation and legacy evidence outside action execution."
    },
    "whiteboards": {
      "disposition": "retire",
      "wave": "S4",
      "reason": "Remove board phase/vote orchestration; preserve existing board evidence and detach attention/corpus readers before runtime deletion."
    },
    "workspace_wrappers": {
      "disposition": "retire",
      "wave": "S3",
      "reason": "Remove restricted workflow worker wrappers; harness tools own filesystem/git execution and existing corpus tools own indexed tool-call recall."
    },
    "policy_packets": {
      "disposition": "slim",
      "wave": "S4",
      "reason": "Keep deterministic permission/surface policy and scoped policy diagnostics; remove workflow routing and automatic continuation policy consumers."
    },
    "cross_cutting": {
      "disposition": "slim",
      "wave": "S4",
      "reason": "Keep corpus/admin capability; remove retired catalogs, runtime hooks and instructions while preserving historical evidence. Remaining response audit is not closed."
    },
    "corpus_and_operations": {
      "disposition": "keep",
      "wave": "S5",
      "reason": "Outside orchestration retirement. Keep capability; this disposition is not a claim that its response/DTO audit has passed."
    }
  },
