{
  "domain": "hook-when/apply-succeeded",
  "version": 3,
  "scope": "global",
  "classification_lattice": ["allow", "deny"],
  "rules": [
    {
      "id": "allow_when_already_applied_short_circuit",
      "classification": "allow",
      "antecedent": {
        "op": "Eq",
        "field": "vars.begin_response.outcome",
        "value": "already_applied"
      },
      "consequent": "allow"
    },
    {
      "id": "allow_when_complete_returned_applied",
      "classification": "allow",
      "antecedent": {
        "op": "Eq",
        "field": "vars.complete_response.status",
        "value": "applied"
      },
      "consequent": "allow"
    },
    {
      "id": "fallback_deny",
      "classification": "deny",
      "antecedent": { "op": "True" },
      "consequent": "deny"
    }
  ]
}
