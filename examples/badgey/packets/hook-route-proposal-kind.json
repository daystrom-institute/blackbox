{
  "domain": "hook-route/proposal-kind",
  "version": 1,
  "scope": "global",
  "classification_lattice": ["redispatch", "install", "skip"],
  "rules": [
    {
      "id": "redispatch_when_begin_outcome_redispatch",
      "classification": "redispatch",
      "antecedent": {
        "op": "Eq",
        "field": "vars.begin_response.outcome",
        "value": "redispatch"
      },
      "consequent": "redispatch"
    },
    {
      "id": "install_when_begin_outcome_install",
      "classification": "install",
      "antecedent": {
        "op": "Eq",
        "field": "vars.begin_response.outcome",
        "value": "install"
      },
      "consequent": "install"
    },
    {
      "id": "skip_default",
      "classification": "skip",
      "antecedent": { "op": "True" },
      "consequent": "skip"
    }
  ]
}
