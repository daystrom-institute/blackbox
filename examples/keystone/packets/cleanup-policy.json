{
  "domain": "workflow-cleanup/keep-on-fail",
  "scope": "global",
  "classification_lattice": ["keep", "delete"],
  "rules": [
    {
      "id": "keep_failed_runs",
      "classification": "keep",
      "antecedent": {
        "op": "In",
        "field": "meta.arc_outcome",
        "values": ["failed", "cancelled", "timeout"]
      },
      "consequent": "keep"
    },
    {
      "id": "delete_default",
      "classification": "delete",
      "antecedent": { "op": "True" },
      "consequent": "delete"
    }
  ]
}
