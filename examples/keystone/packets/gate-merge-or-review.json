{
  "domain": "workflow-gate/merge-or-review",
  "scope": "global",
  "classification_lattice": ["merged", "ready", "halt"],
  "rules": [
    {
      "id": "merged_short_circuit",
      "classification": "merged",
      "antecedent": {
        "op": "Eq", "field": "last_signal.name", "value": "pr-merged"
      },
      "consequent": "merged"
    },
    {
      "id": "ready_for_review",
      "classification": "ready",
      "antecedent": {
        "op": "Eq", "field": "last_signal.name", "value": "pr-ready"
      },
      "consequent": "ready"
    },
    {
      "id": "halt_on_timeout_or_unknown",
      "classification": "halt",
      "antecedent": { "op": "True" },
      "consequent": "halt"
    }
  ]
}
