{
  "domain": "workflow-gate/identity-status",
  "scope": "global",
  "classification_lattice": ["ready", "pending"],
  "rules": [
    {
      "id": "identity_ready",
      "classification": "ready",
      "antecedent": {
        "op": "Eq",
        "field": "vars.identity_result.status",
        "value": "ready"
      },
      "consequent": "ready"
    },
    {
      "id": "identity_pending",
      "classification": "pending",
      "antecedent": { "op": "True" },
      "consequent": "pending"
    }
  ]
}
