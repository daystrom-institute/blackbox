{
  "_contract": "reaction/v1",
  "name": "forgejo-ensure-bro-user",
  "version": 1,
  "enabled": true,
  "event_kinds": ["bro.identity.required"],
  "when": "domain:system-event/forgejo-identity-required",
  "idempotency_key": "forgejo:${event.payload.instance}:${event.subject.id}:${event.principal.provider}:${event.principal.model}",
  "action": {
    "op": "atom_invoke",
    "args": {
      "atom": "atom:forgejo-ensure-user@v1",
      "args": {
        "instance": "${event.payload.instance}",
        "bro": "${event.payload.bro}",
        "provider": "${event.payload.provider}",
        "model": "${event.payload.model}",
        "username": "${event.payload.username}",
        "display_name": "${event.payload.display_name}",
        "email": "${event.payload.email}",
        "token_secret_name": "forgejo-bro-${event.payload.username}",
        "admin_token_ref": "secret:forgejo-admin-token",
        "base_url_env": "FORGEJO_BASE_URL"
      }
    }
  },
  "retry": {
    "max_attempts": 5,
    "backoff": "exponential"
  },
  "on_failure": "dead_letter"
}
