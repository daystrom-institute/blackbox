{
  "name": "reviewer-arc-with-identity",
  "version": 2,
  "vars_schema": {
    "owner":            { "kind": "string", "required": true },
    "repo":             { "kind": "string", "required": true },
    "pr_number":        { "kind": "int",    "required": true },
    "forgejo_instance": { "kind": "string", "required": true },
    "pr_diff":          { "kind": "any",    "required": false },
    "review_payload":   { "kind": "object", "required": false },
    "feedback_posted":  { "kind": "bool",   "required": false },
    "identity_result":  { "kind": "object", "required": false }
  },
  "actors": {
    "reviewers": {
      "kind": "ensemble",
      "team": "keystone-reviewers",
      "durable": false,
      "requires": []
    },
    "aggregator": {
      "kind": "executor",
      "brofile": "keystone-review",
      "durable": false,
      "requires": []
    }
  },
  "start": "RequestIdentity",
  "nodes": {
    "RequestIdentity": {
      "actor": "",
      "on_enter": [
        {
          "op": "require_identity",
          "args": {
            "scope":    "forgejo",
            "instance": "${vars.forgejo_instance}",
            "bro":      "keystone-review",
            "provider": "claude",
            "model":    "claude-haiku-4-5-20251001",
            "effort":   "medium",
            "project":  "${meta.project_dir}"
          },
          "into_var": "identity_result",
          "on_failure": "halt"
        }
      ],
      "prompt": "Checking Forgejo identity readiness for bro keystone-review.",
      "gate": "domain:workflow-gate/identity-status",
      "next": {
        "type": "branch",
        "cases": {
          "ready":   "FetchDiff",
          "pending": "AwaitIdentity"
        }
      }
    },
    "AwaitIdentity": {
      "actor": "",
      "prompt": "Waiting for bro.identity.provisioned signal (reaction is provisioning the Forgejo account for keystone-review).",
      "wait": {
        "any_of": [
          { "signal": "bro.identity.provisioned" }
        ]
      },
      "next": { "type": "goto", "to": "RequestIdentity" }
    },
    "FetchDiff": {
      "actor": "",
      "prompt": "Mechanical PR diff fetch via mapped Forgejo identity.",
      "on_enter": [
        {
          "op": "http_json",
          "args": {
            "method": "GET",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls/${vars.pr_number}.diff",
            "headers": {
              "Accept": "text/plain"
            },
            "secret_headers": {
              "Authorization": "token ${vars.identity_result.identity.token_ref}"
            },
            "response_kind": "text",
            "allow_empty_body": true
          },
          "into_var": "pr_diff",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "Review" }
    },
    "Review": {
      "actor": "reviewers",
      "prompt": "PR #${vars.pr_number} on ${vars.owner}/${vars.repo}.\n\nDIFF:\n${vars.pr_diff}\n\nReview against:\n  1. Does this fix the bug as described in the PR body?\n  2. Are tests added/updated to cover the change?\n  3. Any obvious regressions, edge cases, or incorrect logic?\n\nReturn ONE LINE — exactly one of:\n  APPROVE\n  REQUEST CHANGES: <one-paragraph specific feedback>\n\nBe terse, no filler. The aggregator step combines all reviewers' verdicts into one PR review.",
      "next": { "type": "goto", "to": "Aggregate" }
    },
    "Aggregate": {
      "actor": "aggregator",
      "prompt": "Aggregate the prior reviewer round into ONE structured review payload for PR #${vars.pr_number}.\n\nPRIOR ROUND OUTPUTS (one block per reviewer):\n${Review.output}\n\nReturn STRICT JSON with no surrounding prose, no markdown fences, exactly:\n{\n  \"event\": \"COMMENT\",\n  \"body\": \"<one-to-three sentence aggregate; lead with APPROVE or REQUEST CHANGES then the reasoning>\",\n  \"action\": \"merge\" | \"request_changes\"\n}\n\nUse action=merge ONLY when every reviewer line was APPROVE. Otherwise action=request_changes. event is always COMMENT (this demo runs single-user-per-bro; Forgejo refuses APPROVED/REQUEST_CHANGES on own PRs but the identity extension creates distinct bro Forgejo users so APPROVED/REQUEST_CHANGES is safe — keep COMMENT for cross-host compatibility). The downstream PostReview node reads `action` to decide whether to auto-merge: action=merge → POST /merge → fires pr-merged webhook → arc terminates clean. action=request_changes → no merge, the parent loop waits for the next pr-feedback signal.",
      "next": { "type": "goto", "to": "PostReview" }
    },
    "PostReview": {
      "actor": "",
      "prompt": "Mechanical: parse the aggregator's JSON output, post the PR review via the mapped reviewer identity, and merge if approved.",
      "on_enter": [
        {
          "op": "parse_json",
          "args": { "from": "${Aggregate.output}" },
          "into_var": "review_payload",
          "on_failure": "halt"
        },
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls/${vars.pr_number}/reviews",
            "headers": {
              "Accept": "application/json",
              "Content-Type": "application/json"
            },
            "secret_headers": {
              "Authorization": "token ${vars.identity_result.identity.token_ref}"
            },
            "body": {
              "event": "${vars.review_payload.event}",
              "body":  "${vars.review_payload.body}"
            },
            "expect_status": [200, 201]
          },
          "on_failure": "halt"
        },
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls/${vars.pr_number}/merge",
            "headers": {
              "Accept": "application/json",
              "Content-Type": "application/json"
            },
            "secret_headers": {
              "Authorization": "token ${vars.identity_result.identity.token_ref}"
            },
            "body": { "Do": "merge" },
            "expect_status": [200, 201, 204]
          },
          "when": "domain:hook-when/should-merge",
          "on_failure": "halt"
        },
        { "op": "set_var", "args": { "key": "feedback_posted", "value": true } }
      ],
      "next": { "type": "terminal" }
    }
  }
}
