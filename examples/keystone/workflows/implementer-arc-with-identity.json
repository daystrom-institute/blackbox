{
  "name": "implementer-arc-with-identity",
  "version": 2,
  "vars_schema": {
    "issue_number":     { "kind": "int",    "required": true },
    "issue_title":      { "kind": "string", "required": false },
    "issue_body":       { "kind": "string", "required": false },
    "issue_data":       { "kind": "object", "required": false },
    "repo":             { "kind": "string", "required": true },
    "owner":            { "kind": "string", "required": true },
    "forgejo_instance": { "kind": "string", "required": true },
    "branch":           { "kind": "string", "required": false },
    "worktree_path":    { "kind": "string", "required": true },
    "all_open_prs":     { "kind": "array",  "required": false },
    "existing_pr":      { "kind": "any",    "required": false },
    "pr_data":          { "kind": "object", "required": false },
    "pr_number":        { "kind": "int",    "required": false },
    "identity_result":  { "kind": "object", "required": false }
  },
  "actors": {
    "implementer": {
      "kind": "executor",
      "brofile": "keystone-impl",
      "durable": true,
      "compaction_anchor": true,
      "requires": []
    }
  },
  "start": "RequestIdentity",
  "nodes": {
    "RequestIdentity": {
      "actor": "",
      "on_enter": [
        {
          "op": "require_identity",
          "args": {
            "scope":    "forgejo",
            "instance": "${vars.forgejo_instance}",
            "bro":      "keystone-impl",
            "provider": "claude",
            "model":    "claude-sonnet-4-6",
            "effort":   "medium",
            "project":  "${meta.project_dir}",
            "owner":    "${vars.owner}",
            "repo":     "${vars.repo}"
          },
          "into_var": "identity_result",
          "on_failure": "halt"
        }
      ],
      "prompt": "Checking Forgejo identity readiness for bro keystone-impl.",
      "gate": "domain:workflow-gate/identity-status",
      "next": {
        "type": "branch",
        "cases": {
          "ready":   "FetchIssue",
          "pending": "AwaitIdentity"
        }
      }
    },
    "AwaitIdentity": {
      "actor": "",
      "prompt": "Waiting for bro.identity.provisioned signal (reaction is provisioning the Forgejo account for keystone-impl).",
      "wait": {
        "any_of": [
          {
            "signal": "bro.identity.provisioned",
            "correlate": {
              "scope":    { "kind": "const", "value": "forgejo" },
              "instance": { "kind": "json_path", "path": "vars.forgejo_instance" },
              "bro":      { "kind": "const", "value": "keystone-impl" },
              "provider": { "kind": "const", "value": "claude" },
              "model":    { "kind": "const", "value": "claude-sonnet-4-6" }
            }
          }
        ]
      },
      "next": { "type": "goto", "to": "RequestIdentity" }
    },
    "FetchIssue": {
      "actor": "implementer",
      "on_enter": [
        {
          "op": "http_json",
          "args": {
            "method": "GET",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/issues/${vars.issue_number}",
            "headers": {
              "Accept": "application/json"
            },
            "secret_headers": {
              "Authorization": "token ${vars.identity_result.identity.token_ref}"
            }
          },
          "into_var": "issue_data",
          "on_failure": "halt"
        },
        { "op": "set_var", "args": { "key": "issue_title", "value": "${vars.issue_data.title}" } },
        { "op": "set_var", "args": { "key": "issue_body",  "value": "${vars.issue_data.body}" } },
        { "op": "set_var", "args": { "key": "branch", "value": "fix/issue-${vars.issue_number}" } }
      ],
      "prompt": "You are an implementer working in worktree ${vars.worktree_path} on branch ${vars.branch}.\n\nIssue #${vars.issue_number}: ${vars.issue_title}\n\n${vars.issue_body}\n\nUnderstand the bug, fix it, write or update tests so the existing tests pass. Stage changes and commit with a clear message.\n\nDo NOT push and do NOT open the PR — those are mechanical follow-ups handled by the workflow engine, not by you.\n\nReturn a one-line summary of what you changed (no markdown). Keep edits minimal and focused on the issue.",
      "next": { "type": "goto", "to": "PushAndOpenPr" }
    },
    "PushAndOpenPr": {
      "actor": "",
      "prompt": "Push branch + open-or-reuse PR (mechanical, no LLM dispatch). Git push and PR create/list both use the mapped per-bro Forgejo identity so the PR author shows as bro-keystone-impl-claude-*, distinct from the reviewer principal.",
      "on_enter": [
        {
          "op": "shell",
          "args": {
            "argv": [
              "bash",
              "-lc",
              "set -euo pipefail\norig=$(git remote get-url origin)\nrestore() { git remote set-url origin \"$orig\" >/dev/null 2>&1 || true; }\ntrap restore EXIT\ncase \"$FORGEJO_BASE_URL\" in\n  http://*) remote=\"http://${FORGEJO_PUSH_USER}:${FORGEJO_PUSH_TOKEN}@${FORGEJO_BASE_URL#http://}/${FORGEJO_OWNER}/${FORGEJO_REPO}.git\" ;;\n  https://*) remote=\"https://${FORGEJO_PUSH_USER}:${FORGEJO_PUSH_TOKEN}@${FORGEJO_BASE_URL#https://}/${FORGEJO_OWNER}/${FORGEJO_REPO}.git\" ;;\n  *) echo \"unsupported FORGEJO_BASE_URL scheme\" >&2; exit 2 ;;\nesac\ngit remote set-url origin \"$remote\"\ngit push -u origin \"$FORGEJO_BRANCH\""
            ],
            "cwd": "${vars.worktree_path}",
            "env": {
              "FORGEJO_BASE_URL": "${env.FORGEJO_BASE_URL}",
              "FORGEJO_OWNER": "${vars.owner}",
              "FORGEJO_REPO": "${vars.repo}",
              "FORGEJO_BRANCH": "${vars.branch}",
              "FORGEJO_PUSH_USER": "${vars.identity_result.identity.username}"
            },
            "secret_env": {
              "FORGEJO_PUSH_TOKEN": "${vars.identity_result.identity.token_ref}"
            }
          },
          "on_failure": "halt"
        },
        {
          "op": "http_json",
          "args": {
            "method": "GET",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls?state=open&limit=50",
            "headers": {
              "Accept": "application/json"
            },
            "secret_headers": {
              "Authorization": "token ${vars.identity_result.identity.token_ref}"
            }
          },
          "into_var": "all_open_prs",
          "on_failure": "halt"
        },
        {
          "op": "find_first",
          "args": {
            "from": "${vars.all_open_prs}",
            "where": { "head.ref": "${vars.branch}" }
          },
          "into_var": "existing_pr",
          "on_failure": "halt"
        },
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls",
            "headers": {
              "Accept": "application/json",
              "Content-Type": "application/json"
            },
            "secret_headers": {
              "Authorization": "token ${vars.identity_result.identity.token_ref}"
            },
            "body": {
              "title": "Fix #${vars.issue_number}: ${vars.issue_title}",
              "head": "${vars.branch}",
              "base": "main",
              "body": "Closes #${vars.issue_number}"
            },
            "expect_status": [200, 201]
          },
          "into_var": "pr_data",
          "when": "domain:hook-when/no-existing-pr",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": { "key": "pr_data", "value": "${vars.existing_pr}" },
          "when": "domain:hook-when/has-existing-pr",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": { "key": "pr_number", "value": "${vars.pr_data.number}" },
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
