{
  "name": "issue-to-merged-pr-with-identity",
  "version": 2,
  "vars_schema": {
    "owner":            { "kind": "string", "required": true },
    "repo":             { "kind": "string", "required": true },
    "issue_number":     { "kind": "int",    "required": true },
    "forgejo_instance": { "kind": "string", "required": true },
    "issue_title":      { "kind": "string" },
    "issue_body":       { "kind": "string" },
    "branch":           { "kind": "string" },
    "worktree_path":    { "kind": "string" },
    "pr_number":        { "kind": "int" }
  },
  "actors": {},
  "policy_packet": "domain:workflow-policy/arc-budget",
  "start": "Setup",
  "on_arc_exit": [
    {
      "op": "worktree_remove",
      "args": { "path": "${meta.worktree}", "force": true },
      "when": "domain:workflow-cleanup/keep-on-fail",
      "on_failure": "warn"
    }
  ],
  "nodes": {
    "Setup": {
      "actor": "",
      "on_enter": [
        { "op": "set_var", "args": { "key": "branch", "value": "fix/issue-${vars.issue_number}" } },
        {
          "op": "worktree_create",
          "args": {
            "path":   "/tmp/keystone-arcs/${meta.arc_id}",
            "branch": "${vars.branch}",
            "base":   "main"
          },
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": { "key": "worktree_path", "value": "${meta.worktree}" }
        }
      ],
      "prompt": "Setup complete (no LLM dispatch — hook-only node).",
      "next": { "type": "goto", "to": "Implement" }
    },
    "Implement": {
      "actor": "",
      "subworkflow_ref": "implementer-arc-with-identity",
      "imports": ["owner", "repo", "issue_number", "worktree_path", "forgejo_instance"],
      "exports": ["pr_number", "branch"],
      "next": { "type": "goto", "to": "Review" }
    },
    "Review": {
      "actor": "",
      "subworkflow_ref": "reviewer-arc-with-identity",
      "imports": ["owner", "repo", "pr_number", "forgejo_instance"],
      "exports": ["feedback_posted"],
      "next": { "type": "goto", "to": "Done" }
    },
    "Done": {
      "actor": "",
      "prompt": "Arc terminated.",
      "next": { "type": "terminal" }
    }
  }
}
