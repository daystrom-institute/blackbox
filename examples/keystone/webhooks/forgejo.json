{
  "name": "forgejo",
  "signature": {
    "kind": "forgejo",
    "secret_env": "FORGEJO_WEBHOOK_SECRET"
  },
  "delivery_id_header": "X-Gitea-Delivery",
  "extractor": {
    "outputs": {
      "event": {
        "kind": "default",
        "inner": { "kind": "json_path", "path": "$._headers.x-gitea-event" },
        "fallback": "unknown"
      },
      "action": {
        "kind": "default",
        "inner": { "kind": "json_path", "path": "$.action" },
        "fallback": "unknown"
      },
      "issue_number": {
        "kind": "json_path",
        "path": "$.issue.number"
      },
      "issue_title": {
        "kind": "json_path",
        "path": "$.issue.title"
      },
      "pr_number": {
        "kind": "json_path",
        "path": "$.pull_request.number"
      },
      "pr_title": {
        "kind": "json_path",
        "path": "$.pull_request.title"
      },
      "merged": {
        "kind": "default",
        "inner": { "kind": "json_path", "path": "$.pull_request.merged" },
        "fallback": false
      },
      "review_state": {
        "kind": "json_path",
        "path": "$.review.state"
      },
      "repo": {
        "kind": "json_path",
        "path": "$.repository.full_name"
      },
      "sender": {
        "kind": "json_path",
        "path": "$.sender.login"
      }
    }
  },
  "routing_packet": "domain:webhook-routing/forgejo"
}
