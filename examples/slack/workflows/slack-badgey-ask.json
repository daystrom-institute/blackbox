{
  "name": "slack-badgey-ask",
  "version": 1,
  "vars_schema": {
    "channel": { "kind": "string" },
    "user": { "kind": "string" },
    "thread_ts": { "kind": "string" },
    "text": { "kind": "string" },
    "response_url": { "kind": "string" },
    "team_id": { "kind": "string" },
    "bbox_user": { "kind": "string" }
  },
  "actors": {
    "badgey": {
      "kind": "executor",
      "brofile": "badgey-persona",
      "durable": true
    }
  },
  "start": "SetThinkingStatus",
  "nodes": {
    "SetThinkingStatus": {
      "actor": "",
      "on_enter": [
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "https://slack.com/api/assistant.threads.setStatus",
            "headers": {
              "Authorization": "Bearer ${env.SLACK_BOT_TOKEN}",
              "Content-Type": "application/json; charset=utf-8"
            },
            "body": {
              "channel_id": "${vars.channel}",
              "thread_ts": "${vars.thread_ts}",
              "status": "is digging through the corpus..."
            },
            "expect_status": [200]
          },
          "into_var": "thinking_status_response",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "Answer" }
    },
    "Answer": {
      "actor": "badgey",
      "prompt": "Slack user @${vars.bbox_user} mentioned you in channel ${vars.channel}:\n\n${vars.text}\n\nProtocol: run the agentic opening sequence (hybrid_search → inspect_entity round-trip on each ref you plan to cite → find_paths if multi-hop) and finish with a bbox_bundle_evidence call before composing your reply. Use Slack mrkdwn formatting only (bold via *single-asterisks*, italics via _underscores_, code spans via backticks, fenced blocks via triple-backticks, links via <url|label>) — NOT GitHub Markdown headings or tables. Cite entity refs inline like (knowledge:abc12345) or (commit:repo:sha) so users can paste them back. Stay concise; the response is posted as a threaded reply.",
      "next": { "type": "goto", "to": "PostReply" }
    },
    "PostReply": {
      "actor": "",
      "on_enter": [
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "https://slack.com/api/chat.postMessage",
            "headers": {
              "Authorization": "Bearer ${env.SLACK_BOT_TOKEN}",
              "Content-Type": "application/json; charset=utf-8"
            },
            "body": {
              "channel": "${vars.channel}",
              "thread_ts": "${vars.thread_ts}",
              "text": "${outputs.Answer}",
              "mrkdwn": true
            },
            "expect_status": [200]
          },
          "into_var": "post_response",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
