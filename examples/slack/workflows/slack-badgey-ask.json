{
  "name": "slack-badgey-ask",
  "version": 1,
  "vars_schema": {
    "channel": { "kind": "string" },
    "user": { "kind": "string" },
    "thread_ts": { "kind": "string" },
    "text": { "kind": "string" },
    "response_url": { "kind": "string" },
    "team_id": { "kind": "string" },
    "bbox_user": { "kind": "string" }
  },
  "actors": {
    "badgey": {
      "kind": "executor",
      "brofile": "badgey-persona",
      "durable": false
    }
  },
  "start": "Answer",
  "nodes": {
    "Answer": {
      "actor": "badgey",
      "prompt": "[scope]\nbright\nblackboard\n\nSlack user @${vars.bbox_user} mentioned you in channel ${vars.channel}:\n\n${vars.text}\n\nReply with a concise corpus-grounded answer. Use Slack mrkdwn (bold via *, italics via _, code spans via `, fenced blocks via ```, links via <url|label>) — NOT GitHub Markdown headings or tables. Cite entity refs inline like `(knowledge:abc12345)` or `(commit:repo:sha)` so users can paste them back. The response is posted as a threaded reply.",
      "next": { "type": "goto", "to": "PostReply" }
    },
    "PostReply": {
      "actor": "",
      "on_enter": [
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "https://slack.com/api/chat.postMessage",
            "headers": {
              "Authorization": "Bearer ${env.SLACK_BOT_TOKEN}",
              "Content-Type": "application/json; charset=utf-8"
            },
            "body": {
              "channel": "${vars.channel}",
              "thread_ts": "${vars.thread_ts}",
              "text": "${outputs.Answer}",
              "mrkdwn": true
            },
            "expect_status": [200]
          },
          "into_var": "post_response",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
