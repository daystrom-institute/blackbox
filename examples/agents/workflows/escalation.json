{
  "name": "agent-escalation",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "CheapAttempt",
  "vars_schema": {
    "prompt": { "kind": "string", "required": true },
    "cheap_dispatch": { "kind": "any" },
    "expensive_dispatch": { "kind": "any" }
  },
  "nodes": {
    "CheapAttempt": {
      "actor": "placeholder",
      "prompt": "Attempt the task cheaply: ${vars.prompt}",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "cheap-agent",
              "args": { "prompt": "${vars.prompt}" }
            },
            "timeout_secs": 60
          },
          "into_var": "cheap_dispatch",
          "on_failure": "halt"
        }
      ],
      "gate": "packet-escalation-judge",
      "next": {
        "type": "branch",
        "cases": {
          "escalate": "Escalate",
          "flag": "Escalate"
        },
        "default": "Done"
      }
    },
    "Escalate": {
      "actor": "placeholder",
      "prompt": "Escalating to expensive agent with context from cheap attempt.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "expensive-agent",
              "args": {
                "prompt": "${vars.prompt}",
                "context": "Cheap agent result: ${vars.cheap_dispatch}"
              }
            },
            "timeout_secs": 120
          },
          "into_var": "expensive_dispatch",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    },
    "Done": {
      "actor": "placeholder",
      "prompt": "Cheap agent was sufficient. Result: ${vars.cheap_dispatch}",
      "next": { "type": "terminal" }
    }
  }
}
