{
  "name": "agent-escalation",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "CheapAttempt",
  "vars_schema": {
    "prompt": { "kind": "string", "required": true },
    "cheap_handle": { "kind": "any" },
    "cheap_output": { "kind": "any" },
    "expensive_handle": { "kind": "any" }
  },
  "nodes": {
    "CheapAttempt": {
      "actor": "placeholder",
      "prompt": "Escalation: dispatching cheap agent, then evaluating output quality.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "cheap-agent",
              "args": { "prompt": "${vars.prompt}" }
            },
            "timeout_secs": 60
          },
          "into_var": "cheap_handle",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.cheap_handle.taskId}",
              "timeout_seconds": 60
            },
            "timeout_secs": 70
          },
          "into_var": "cheap_output",
          "on_failure": "halt"
        }
      ],
      "gate": "packet-escalation-judge",
      "next": {
        "type": "branch",
        "cases": {
          "escalate": "Escalate",
          "flag": "Escalate"
        },
        "default": "Done"
      }
    },
    "Escalate": {
      "actor": "placeholder",
      "prompt": "Escalating to expensive agent. Cheap agent output was unsuitable.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "expensive-agent",
              "args": {
                "prompt": "${vars.prompt}",
                "context": "Cheap agent result: ${vars.cheap_output.result}"
              }
            },
            "timeout_secs": 120
          },
          "into_var": "expensive_handle",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    },
    "Done": {
      "actor": "placeholder",
      "prompt": "Cheap agent output was sufficient. Result: ${vars.cheap_output.result}",
      "next": { "type": "terminal" }
    }
  }
}
