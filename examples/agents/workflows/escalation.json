{
  "name": "agent-escalation",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "CheapAttempt",
  "vars_schema": {
    "diff": { "kind": "string", "required": true },
    "cheap_handle": { "kind": "any" },
    "cheap_output": { "kind": "any" },
    "expensive_handle": { "kind": "any" }
  },
  "nodes": {
    "CheapAttempt": {
      "actor": "placeholder",
      "prompt": "Escalation: dispatching cheap diff-narrator, then evaluating output quality.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "diff-narrator",
              "args": { "diff": "${vars.diff}" }
            },
            "timeout_secs": 60
          },
          "into_var": "cheap_handle",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.cheap_handle.task_id}",
              "timeout_seconds": 60
            },
            "timeout_secs": 70
          },
          "into_var": "cheap_output",
          "on_failure": "halt"
        }
      ],
      "gate": "packet-escalation-judge",
      "next": {
        "type": "branch",
        "cases": {
          "escalate": "Escalate",
          "flag": "Escalate"
        },
        "default": "Done"
      }
    },
    "Escalate": {
      "actor": "placeholder",
      "prompt": "Escalating to code-reviewer. Diff-narrator output was unsuitable.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "code-reviewer",
              "args": { "diff": "${vars.diff}" }
            },
            "timeout_secs": 120
          },
          "into_var": "expensive_handle",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    },
    "Done": {
      "actor": "placeholder",
      "prompt": "Diff-narrator output was sufficient. Result: ${vars.cheap_output.result}",
      "next": { "type": "terminal" }
    }
  }
}
