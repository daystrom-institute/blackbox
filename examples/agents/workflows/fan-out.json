{
  "name": "agent-fan-out",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "DispatchBoth",
  "vars_schema": {
    "diff": { "kind": "string", "required": true },
    "left_handle": { "kind": "any" },
    "right_handle": { "kind": "any" },
    "left_output": { "kind": "any" },
    "right_output": { "kind": "any" }
  },
  "nodes": {
    "DispatchBoth": {
      "actor": "placeholder",
      "prompt": "Fan-out: dispatching diff-narrator and code-reviewer sequentially (engine on_enter hooks run in order); then waiting for both.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "diff-narrator",
              "args": { "diff": "${vars.diff}" }
            },
            "timeout_secs": 120
          },
          "into_var": "left_handle",
          "on_failure": "warn"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "code-reviewer",
              "args": { "diff": "${vars.diff}" }
            },
            "timeout_secs": 120
          },
          "into_var": "right_handle",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "WaitBoth" }
    },
    "WaitBoth": {
      "actor": "placeholder",
      "prompt": "Waiting for both agents to complete.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.left_handle.task_id}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "left_output",
          "on_failure": "warn"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.right_handle.task_id}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "right_output",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "Aggregate" }
    },
    "Aggregate": {
      "actor": "placeholder",
      "prompt": "Fan-out aggregation. Synthesize both agent outputs into a balanced recommendation.\n\nDiff-narrator output:\n${vars.left_output.result}\n\nCode-reviewer output:\n${vars.right_output.result}",
      "next": { "type": "terminal" }
    }
  }
}
