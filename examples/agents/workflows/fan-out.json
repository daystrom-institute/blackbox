{
  "name": "agent-fan-out",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "FanOut",
  "vars_schema": {
    "prompt": { "kind": "string", "required": true },
    "left_dispatch": { "kind": "any" },
    "right_dispatch": { "kind": "any" }
  },
  "nodes": {
    "FanOut": {
      "actor": "placeholder",
      "prompt": "Fan-out dispatched. Waiting for branch outputs.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "left-agent",
              "args": { "prompt": "${vars.prompt}" }
            },
            "timeout_secs": 120
          },
          "into_var": "left_dispatch",
          "on_failure": "warn"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "right-agent",
              "args": { "prompt": "${vars.prompt}" }
            },
            "timeout_secs": 120
          },
          "into_var": "right_dispatch",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "Aggregate" }
    },
    "Aggregate": {
      "actor": "placeholder",
      "prompt": "Fan-out results:\n\nLeft: ${vars.left_dispatch}\n\nRight: ${vars.right_dispatch}\n\nSynthesize both into a balanced recommendation.",
      "next": { "type": "terminal" }
    }
  }
}
