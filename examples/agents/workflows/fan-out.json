{
  "name": "agent-fan-out",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "FanOut",
  "vars_schema": {
    "prompt": { "kind": "string", "required": true },
    "left_handle": { "kind": "any" },
    "right_handle": { "kind": "any" },
    "left_output": { "kind": "any" },
    "right_output": { "kind": "any" }
  },
  "nodes": {
    "FanOut": {
      "actor": "placeholder",
      "prompt": "Fan-out: dispatching left and right agents in parallel.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "left-agent",
              "args": { "prompt": "${vars.prompt}" }
            },
            "timeout_secs": 120
          },
          "into_var": "left_handle",
          "on_failure": "warn"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "right-agent",
              "args": { "prompt": "${vars.prompt}" }
            },
            "timeout_secs": 120
          },
          "into_var": "right_handle",
          "on_failure": "warn"
        }
      ],
      "next": {
        "type": "fork",
        "branches": ["WaitLeft", "WaitRight"],
        "continue_to": "Aggregate"
      }
    },
    "WaitLeft": {
      "actor": "placeholder",
      "prompt": "Waiting for left agent to complete.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.left_handle.taskId}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "left_output",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "terminal" }
    },
    "WaitRight": {
      "actor": "placeholder",
      "prompt": "Waiting for right agent to complete.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.right_handle.taskId}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "right_output",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "terminal" }
    },
    "Aggregate": {
      "actor": "placeholder",
      "wait_for": ["WaitLeft", "WaitRight"],
      "prompt": "Fan-out aggregation. Synthesize both agent outputs into a balanced recommendation.\n\nLeft agent output:\n${vars.left_output.result}\n\nRight agent output:\n${vars.right_output.result}",
      "next": { "type": "terminal" }
    }
  }
}
