{
  "name": "agent-chain",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "DispatchFirst",
  "vars_schema": {
    "input": { "kind": "string", "required": true },
    "first_dispatch": { "kind": "any" },
    "first_result": { "kind": "any" },
    "second_dispatch": { "kind": "any" }
  },
  "nodes": {
    "DispatchFirst": {
      "actor": "placeholder",
      "prompt": "Chain step 1 dispatched.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "first-agent",
              "args": { "input": "${vars.input}" }
            },
            "timeout_secs": 120
          },
          "into_var": "first_dispatch",
          "on_failure": "halt"
        },
        {
          "op": "parse_json",
          "args": { "source": "${vars.first_dispatch}" },
          "into_var": "first_result",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "DispatchSecond" }
    },
    "DispatchSecond": {
      "actor": "placeholder",
      "prompt": "Chain step 2 dispatched.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "second-agent",
              "args": { "input": "${vars.first_result.output}" }
            },
            "timeout_secs": 120
          },
          "into_var": "second_dispatch",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
