{
  "name": "agent-chain",
  "version": 1,
  "actors": {
    "placeholder": {
      "kind": "executor",
      "brofile": "probe-haiku"
    }
  },
  "start": "RunFirst",
  "vars_schema": {
    "input": { "kind": "string", "required": true },
    "first_handle": { "kind": "any" },
    "first_output": { "kind": "any" },
    "second_handle": { "kind": "any" }
  },
  "nodes": {
    "RunFirst": {
      "actor": "placeholder",
      "prompt": "Chain: dispatching first agent, then waiting for completion.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "first-agent",
              "args": { "input": "${vars.input}" }
            },
            "timeout_secs": 120
          },
          "into_var": "first_handle",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.first_handle.taskId}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "first_output",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "RunSecond" }
    },
    "RunSecond": {
      "actor": "placeholder",
      "prompt": "Chain: dispatching second agent with first agent's output.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "second-agent",
              "args": { "input": "${vars.first_output.result}" }
            },
            "timeout_secs": 120
          },
          "into_var": "second_handle",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
