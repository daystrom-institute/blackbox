{
  "name": "agent-chain",
  "version": 1,
  "actors": {},
  "start": "RunFirst",
  "vars_schema": {
    "diff": { "kind": "string", "required": true },
    "first_handle": { "kind": "any" },
    "first_output": { "kind": "any" },
    "second_handle": { "kind": "any" },
    "second_output": { "kind": "any" }
  },
  "nodes": {
    "RunFirst": {
      "prompt": "Chain step 1: diff-narrator dispatched and waited.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "diff-narrator",
              "args": { "diff": "${vars.diff}" }
            },
            "timeout_secs": 120
          },
          "into_var": "first_handle",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.first_handle.task_id}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "first_output",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "RunSecond" }
    },
    "RunSecond": {
      "prompt": "Chain step 2: code-reviewer dispatched with diff-narrator narrative, then waited for completion.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_agent_dispatch",
            "arguments": {
              "agent": "code-reviewer",
              "args": {
                "diff": "${vars.diff}",
                "context_refs": ["${vars.first_output.result}"]
              }
            },
            "timeout_secs": 120
          },
          "into_var": "second_handle",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "bro_wait",
            "arguments": {
              "task_id": "${vars.second_handle.task_id}",
              "timeout_seconds": 120
            },
            "timeout_secs": 130
          },
          "into_var": "second_output",
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
