{
  "name": "whiteboard-arc",
  "version": 1,
  "vars_schema": {
    "owner":             { "kind": "string", "required": true },
    "repo":              { "kind": "string", "required": true },
    "issue_number":      { "kind": "int",    "required": true },
    "issue_title":       { "kind": "string" },
    "issue_body":        { "kind": "string" },
    "branch":            { "kind": "string" },
    "worktree_path":     { "kind": "string" },
    "board_id":          { "kind": "string" },
    "issue_data":        { "kind": "object" },
    "open_result":       { "kind": "any" },
    "register_result":   { "kind": "any" },
    "summary":           { "kind": "any" },
    "synthesis":         { "kind": "string" },
    "adr_path":          { "kind": "string" },
    "adr_slug":          { "kind": "string" },
    "all_open_prs":      { "kind": "array" },
    "existing_pr":       { "kind": "any" },
    "pr_data":           { "kind": "object" },
    "pr_number":         { "kind": "int" },
    "archive_result":    { "kind": "any" }
  },
  "actors": {
    "specialists": {
      "kind": "ensemble",
      "team": "whiteboard-specialists",
      "durable": true,
      "compaction_anchor": true,
      "requires": []
    },
    "facilitator": {
      "kind": "executor",
      "brofile": "whiteboard-facilitator",
      "durable": true,
      "compaction_anchor": true,
      "requires": []
    }
  },
  "policy_packet": "domain:workflow-policy/arc-budget",
  "start": "Setup",
  "on_arc_exit": [
    {
      "op": "worktree_remove",
      "args": { "path": "${meta.worktree}", "force": true },
      "when": "domain:workflow-cleanup/keep-on-fail",
      "on_failure": "warn"
    }
  ],
  "nodes": {
    "Setup": {
      "actor": "",
      "prompt": "Setup — fetch issue, init worktree, derive board id + branch.",
      "on_enter": [
        {
          "op": "http_json",
          "args": {
            "method": "GET",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/issues/${vars.issue_number}",
            "headers": {
              "Authorization": "token ${env.FORGEJO_TOKEN}",
              "Accept": "application/json"
            }
          },
          "into_var": "issue_data",
          "on_failure": "halt"
        },
        { "op": "set_var", "args": { "key": "issue_title", "value": "${vars.issue_data.title}" } },
        { "op": "set_var", "args": { "key": "issue_body",  "value": "${vars.issue_data.body}" } },
        { "op": "set_var", "args": { "key": "board_id", "value": "adr-${vars.issue_number}-${meta.arc_id}" } },
        { "op": "set_var", "args": { "key": "adr_slug", "value": "adr-${vars.issue_number}" } },
        { "op": "set_var", "args": { "key": "branch", "value": "adr/${vars.issue_number}-${meta.arc_id}" } },
        {
          "op": "worktree_create",
          "args": {
            "path":   "/tmp/whiteboard-arcs/${meta.arc_id}",
            "branch": "${vars.branch}",
            "base":   "main"
          },
          "on_failure": "halt"
        },
        { "op": "set_var", "args": { "key": "worktree_path", "value": "${meta.worktree}" } }
      ],
      "next": { "type": "goto", "to": "OpenBoard" }
    },
    "OpenBoard": {
      "actor": "",
      "prompt": "Mechanical: open the whiteboard, register the facilitator + the three specialists.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_open",
            "arguments": {
              "board_id": "${vars.board_id}",
              "topic": "ADR #${vars.issue_number}: ${vars.issue_title}",
              "project": "${vars.worktree_path}",
              "arc_thread_id": "${meta.arc_id}",
              "opened_by": "facilitator",
              "domain": "facilitation"
            },
            "timeout_secs": 30
          },
          "into_var": "open_result",
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "security",
              "role": "specialist",
              "domain": "threat-modeling"
            }
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "performance",
              "role": "specialist",
              "domain": "perf-analysis"
            }
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "design",
              "role": "specialist",
              "domain": "design-coherence"
            }
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_register",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "operator",
              "role": "operator",
              "domain": "human-in-the-loop"
            }
          },
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "BlindPost" }
    },
    "BlindPost": {
      "actor": "specialists",
      "prompt": "Whiteboard board: ${vars.board_id} (phase: blind)\n\nADR proposal:\n  Title: ${vars.issue_title}\n  Body:\n${vars.issue_body}\n\nYour role on the board is **specialist** — your `agent_name` matches your team-member name (`security`, `performance`, or `design`). Do not see other specialists' posts during this round.\n\n**Action:** call `mcp__blackbox__whiteboard_post` with:\n  - board_id: \"${vars.board_id}\"\n  - agent_name: <your role-name as above>\n  - type: one of \"proposal\" / \"claim\" / \"concern\" / \"informational\"\n  - title: short headline (≤ 80 chars)\n  - body: 2–4 sentences from your perspective on the proposed ADR\n  - severity: one of \"critical\" / \"high\" / \"medium\" / \"low\" if you're flagging risk\n\nReturn ONE LINE confirming what you posted (no markdown).",
      "next": { "type": "goto", "to": "TransitionToDebate" }
    },
    "TransitionToDebate": {
      "actor": "",
      "prompt": "Mechanical: transition the board read → debate (skip validate; this demo uses the abbreviated path).",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "facilitator",
              "target_phase": "read"
            }
          },
          "on_failure": "halt"
        },
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "facilitator",
              "target_phase": "debate"
            }
          },
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "Debate" }
    },
    "Debate": {
      "actor": "specialists",
      "prompt": "Whiteboard board: ${vars.board_id} (phase: debate)\n\nThe board has transitioned. All specialists' blind posts are now visible. Read the full board via:\n  `mcp__blackbox__whiteboard_state(board_id=\"${vars.board_id}\", agent_name=<your role>)`\n\n**Action:** for each peer's post you have a position on, call **either**:\n  - `whiteboard_annotate(type=\"challenge\"|\"corroborate\", post_id, body)` — explain your stance\n  - `whiteboard_vote(post_id, vote=\"accept\"|\"reject\"|\"defer\", reason)` — record your verdict\n\nDo not annotate your own posts. You may annotate AND vote on the same peer post. Be terse.\n\nReturn ONE LINE summarizing your annotations + votes.",
      "next": { "type": "goto", "to": "TransitionToResolve" }
    },
    "TransitionToResolve": {
      "actor": "",
      "prompt": "Mechanical: transition the board to resolve.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_transition",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "facilitator",
              "target_phase": "resolve"
            }
          },
          "on_failure": "halt"
        }
      ],
      "next": { "type": "goto", "to": "Synthesize" }
    },
    "Synthesize": {
      "actor": "facilitator",
      "prompt": "Whiteboard board: ${vars.board_id} (phase: resolve)\n\nThe deliberation is closed. Read the final state via:\n  `mcp__blackbox__whiteboard_state(board_id=\"${vars.board_id}\", agent_name=\"facilitator\")`\n  `mcp__blackbox__whiteboard_summarize(board_id=\"${vars.board_id}\", agent_name=\"facilitator\")`\n\n**Action:** synthesize an ADR (Architecture Decision Record) markdown document at the path printed below. The ADR should:\n  1. Title — derived from the issue\n  2. Status — Accepted / Rejected / Deferred (driven by the vote tally)\n  3. Context — short paragraph framing the question (from the issue body)\n  4. Specialist stances — one short paragraph each summarizing security / performance / design specialist's blind post\n  5. Discussion — what each specialist annotated, and how challenges resolved (if any)\n  6. Decision — the synthesized verdict, citing the vote tally\n  7. Consequences — what this commits the project to\n\nWrite the file to: `${vars.worktree_path}/docs/adrs/${vars.adr_slug}.md`\n\nThen `cd ${vars.worktree_path} && git add docs/adrs && git commit -m \"adr: ${vars.issue_title}\"`. Do NOT push — that's the next mechanical step.\n\nReturn ONE LINE summarizing the decision (e.g. \"Accepted — async runtime X adopted per 3/3 vote\")",
      "on_exit": [
        { "op": "set_var", "args": { "key": "synthesis", "value": "${Synthesize.output}" } },
        { "op": "set_var", "args": { "key": "adr_path",  "value": "docs/adrs/${vars.adr_slug}.md" } }
      ],
      "next": { "type": "goto", "to": "PushAndOpenPr" }
    },
    "PushAndOpenPr": {
      "actor": "",
      "prompt": "Mechanical: push the ADR branch + open-or-reuse the PR.",
      "on_enter": [
        {
          "op": "shell",
          "args": {
            "argv": ["git", "push", "-u", "origin", "${vars.branch}"],
            "cwd": "${vars.worktree_path}"
          },
          "on_failure": "halt"
        },
        {
          "op": "http_json",
          "args": {
            "method": "GET",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls?state=open&limit=50",
            "headers": {
              "Authorization": "token ${env.FORGEJO_TOKEN}",
              "Accept": "application/json"
            }
          },
          "into_var": "all_open_prs",
          "on_failure": "halt"
        },
        {
          "op": "find_first",
          "args": {
            "from": "${vars.all_open_prs}",
            "where": { "head.ref": "${vars.branch}" }
          },
          "into_var": "existing_pr",
          "on_failure": "halt"
        },
        {
          "op": "http_json",
          "args": {
            "method": "POST",
            "url": "${env.FORGEJO_BASE_URL}/api/v1/repos/${vars.owner}/${vars.repo}/pulls",
            "headers": {
              "Authorization": "token ${env.FORGEJO_TOKEN}",
              "Accept": "application/json",
              "Content-Type": "application/json"
            },
            "body": {
              "title": "ADR #${vars.issue_number}: ${vars.issue_title}",
              "head": "${vars.branch}",
              "base": "main",
              "body": "Closes #${vars.issue_number}.\n\n**Synthesis:** ${vars.synthesis}\n\n_Whiteboard: ${vars.board_id}_"
            },
            "expect_status": [200, 201]
          },
          "into_var": "pr_data",
          "when": "domain:hook-when/no-existing-pr",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": { "key": "pr_data", "value": "${vars.existing_pr}" },
          "when": "domain:hook-when/has-existing-pr",
          "on_failure": "halt"
        },
        {
          "op": "set_var",
          "args": { "key": "pr_number", "value": "${vars.pr_data.number}" }
        }
      ],
      "next": { "type": "goto", "to": "AwaitMerge" }
    },
    "AwaitMerge": {
      "actor": "",
      "wait": {
        "any_of": [
          { "signal": "pr-merged", "correlate": { "pr": { "kind": "json_path", "path": "vars.pr_number" } } }
        ],
        "timeout": "24h"
      },
      "next": { "type": "goto", "to": "Done" }
    },
    "Done": {
      "actor": "",
      "prompt": "Arc terminated — ADR merged. Archive the board.",
      "on_enter": [
        {
          "op": "mcp_call",
          "args": {
            "server": "blackbox",
            "tool": "whiteboard_archive",
            "arguments": {
              "board_id": "${vars.board_id}",
              "agent_name": "facilitator"
            },
            "timeout_secs": 30
          },
          "into_var": "archive_result",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
