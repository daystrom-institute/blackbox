{
  "name": "whiteboard",
  "signature": {
    "kind": "hmac_sha256",
    "secret_env": "FORGEJO_WEBHOOK_SECRET",
    "header": "X-Gitea-Signature"
  },
  "delivery_id_header": "X-Gitea-Delivery",
  "extractor": {
    "outputs": {
      "event": {
        "kind": "default",
        "inner": { "kind": "json_path", "path": "$._headers.x-gitea-event" },
        "fallback": "unknown"
      },
      "action": {
        "kind": "default",
        "inner": { "kind": "json_path", "path": "$.action" },
        "fallback": "unknown"
      },
      "issue_number": { "kind": "json_path", "path": "$.issue.number" },
      "issue_title":  { "kind": "json_path", "path": "$.issue.title" },
      "pr_number": { "kind": "json_path", "path": "$.pull_request.number" },
      "merged": {
        "kind": "default",
        "inner": { "kind": "json_path", "path": "$.pull_request.merged" },
        "fallback": false
      },
      "owner": { "kind": "json_path", "path": "$.repository.owner.login" },
      "repo":  { "kind": "json_path", "path": "$.repository.name" }
    }
  },
  "routing_packet": "domain:webhook-routing/whiteboard",
  "default_project_dir": "/tmp/whiteboard-clone-quat"
}
