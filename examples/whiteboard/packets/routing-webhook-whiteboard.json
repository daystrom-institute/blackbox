{
  "domain": "webhook-routing/whiteboard",
  "scope": "global",
  "classification_lattice": ["start_arc", "signal_arc", "ignore", "dead_letter"],
  "rules": [
    {
      "id": "start_arc_on_issue_opened",
      "classification": "start_arc",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "event", "value": "issues" },
          { "op": "Eq", "field": "action", "value": "opened" }
        ]
      },
      "consequent": "{\"route\":\"start_arc\",\"workflow\":\"whiteboard-arc\",\"initial_vars\":{}}"
    },
    {
      "id": "signal_pr_merged",
      "classification": "signal_arc",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "event", "value": "pull_request" },
          { "op": "Eq", "field": "action", "value": "closed" },
          { "op": "Eq", "field": "merged", "value": true }
        ]
      },
      "consequent": "{\"route\":\"signal_arc\",\"signal\":\"pr-merged\",\"correlate\":{\"pr\":\"${entity.pr_number}\"}}"
    },
    {
      "id": "ignore_issue_other_actions",
      "classification": "ignore",
      "antecedent": { "op": "Eq", "field": "event", "value": "issues" },
      "consequent": "ignore"
    },
    {
      "id": "ignore_pr_other_actions",
      "classification": "ignore",
      "antecedent": { "op": "Eq", "field": "event", "value": "pull_request" },
      "consequent": "ignore"
    },
    {
      "id": "ignore_push_events",
      "classification": "ignore",
      "antecedent": { "op": "Eq", "field": "event", "value": "push" },
      "consequent": "ignore"
    }
  ]
}
