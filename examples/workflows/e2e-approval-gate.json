{
  "name": "e2e-approval-gate",
  "version": 1,
  "actors": {
    "haiku": {
      "kind": "executor",
      "brofile": "probe-haiku",
      "durable": true
    }
  },
  "vars_schema": {
    "request_id": { "kind": "string", "required": true }
  },
  "start": "PrepareProposal",
  "nodes": {
    "PrepareProposal": {
      "actor": "haiku",
      "prompt": "Draft one short sentence proposing a small, reversible change (request id ${vars.request_id}). No preamble.",
      "next": { "type": "goto", "to": "AwaitApproval" }
    },
    "AwaitApproval": {
      "actor": "",
      "wait": {
        "any_of": [
          {
            "signal": "operator-approval",
            "correlate": {
              "request_id": { "kind": "json_path", "path": "vars.request_id" }
            }
          }
        ],
        "timeout": "24h"
      },
      "gate": "packet-approval-decision-TODO",
      "next": {
        "type": "branch",
        "cases": { "approved": "Proceed", "rejected": "Cancelled" },
        "default": "Cancelled"
      }
    },
    "Proceed": {
      "actor": "haiku",
      "prompt": "The operator approved this proposal: ${outputs.PrepareProposal}. Say one short confirming sentence. No preamble.",
      "next": { "type": "terminal" }
    },
    "Cancelled": {
      "actor": "haiku",
      "prompt": "The operator rejected the proposal, or never responded before the wait timed out. Say one short acknowledging sentence. No preamble.",
      "next": { "type": "terminal" }
    }
  }
}
