{
  "name": "blind-converge",
  "version": 1,
  "actors": {
    "executor": {
      "kind": "executor",
      "brofile": "codex-executor",
      "durable": true,
      "compaction_anchor": true
    },
    "ensemble_blind_pre": {
      "kind": "ensemble",
      "team": "blind-review-team"
    },
    "ensemble_blind_post": {
      "kind": "ensemble",
      "team": "blind-review-team"
    }
  },
  "start": "Exec_Propose",
  "nodes": {
    "Exec_Propose": {
      "actor": "executor",
      "prompt": "Propose an implementation approach for: ${arc_goal}",
      "gate": "packet-proposal-well-formed",
      "retry": { "max_generations": 5 },
      "next": { "type": "goto", "to": "Ensemble_Blind_Iter" }
    },
    "Ensemble_Blind_Iter": {
      "actor": "ensemble_blind_pre",
      "prompt": "Review the proposal blind: ${Exec_Propose.output}",
      "gate": "packet-ensemble-convergence",
      "next": {
        "type": "branch",
        "cases": {
          "revise":    "Exec_Propose",
          "converged": "Exec_Work"
        }
      }
    },
    "Exec_Work": {
      "actor": "executor",
      "prompt": "Implement the converged proposal: ${Exec_Propose.output}",
      "gate": "packet-done-claim",
      "retry": { "max_generations": 3 },
      "next": { "type": "goto", "to": "Ensemble_Blind_Final" }
    },
    "Ensemble_Blind_Final": {
      "actor": "ensemble_blind_post",
      "prompt": "Final blind review of implemented work: ${Exec_Work.output}",
      "gate": "packet-final-review",
      "next": { "type": "terminal" }
    }
  }
}
