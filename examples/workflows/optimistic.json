{
  "name": "optimistic-review",
  "version": 1,
  "actors": {
    "executor": {
      "kind": "executor",
      "brofile": "codex-executor",
      "durable": true,
      "compaction_anchor": true
    },
    "ensemble_durable": {
      "kind": "ensemble",
      "team": "red-team",
      "durable": true
    }
  },
  "start": "P1_Executor",
  "nodes": {
    "P1_Executor": {
      "actor": "executor",
      "prompt": "${phase1_brief}",
      "gate": "packet-done-claim",
      "retry": { "max_generations": 3 },
      "next": {
        "type": "fork",
        "branches": ["Ensemble_Durable_Review_1"],
        "continue_to": "P2_Executor"
      }
    },
    "Ensemble_Durable_Review_1": {
      "actor": "ensemble_durable",
      "prompt": "Review the output of P1_Executor: ${P1_Executor.output}",
      "mode": "fire_and_forget",
      "next": { "type": "terminal" }
    },
    "P2_Executor": {
      "actor": "executor",
      "prompt": "${phase2_brief}",
      "gate": "packet-done-claim",
      "retry": { "max_generations": 3 },
      "late_inject": {
        "from": "Ensemble_Durable_Review_1",
        "policy": "resume_on_return"
      },
      "next": { "type": "terminal" }
    }
  }
}
