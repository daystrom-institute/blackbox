{
  "name": "optimistic-review",
  "version": 1,
  "actors": {
    "executor": {
      "kind": "executor",
      "brofile": "codex-executor",
      "durable": true,
      "compaction_anchor": true
    },
    "ensemble_durable": {
      "kind": "ensemble",
      "team": "red-team",
      "durable": true
    }
  },
  "nodes": {
    "P1_Executor": {
      "actor": "executor",
      "prompt": "${phase1_brief}",
      "gate": "packet-done-claim",
      "retry": { "max_generations": 3 }
    },
    "Ensemble_Durable_Review_1": {
      "actor": "ensemble_durable",
      "prompt": "Review the output of P1_Executor: ${P1_Executor.output}",
      "mode": "fire_and_forget"
    },
    "P2_Executor": {
      "actor": "executor",
      "prompt": "${phase2_brief}",
      "gate": "packet-done-claim",
      "retry": { "max_generations": 3 },
      "late_inject": {
        "from": "Ensemble_Durable_Review_1",
        "policy": "resume_on_return"
      }
    }
  },
  "graph": "stateDiagram-v2\n    [*] --> P1_Executor\n    state fork_phase1 <<fork>>\n    P1_Executor --> fork_phase1\n    fork_phase1 --> P2_Executor\n    fork_phase1 --> Ensemble_Durable_Review_1\n    Ensemble_Durable_Review_1 --> P2_Executor: late-inject\n    P2_Executor --> [*]"
}
