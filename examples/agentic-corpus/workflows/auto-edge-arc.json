{
  "name": "auto-edge-arc",
  "version": 1,
  "policy_packet": "domain:workflow-policy/arc-budget",
  "vars_schema": {
    "candidate_pairs": { "kind": "object" },
    "candidate": { "kind": "object" },
    "votes": { "kind": "array" },
    "vote_aggregate": { "kind": "object" },
    "semantic_edge": { "kind": "any" }
  },
  "actors": {
    "classifiers": {
      "kind": "ensemble",
      "team": "auto-edge-classifiers",
      "durable": false,
      "requires": []
    }
  },
  "start": "Setup",
  "nodes": {
    "Setup": {
      "actor": "",
      "on_enter": [
        {
          "op": "extract_candidate_pairs",
          "args": {
            "limit": 50,
            "edge_kinds": ["DESCRIBES", "REFERENCES"]
          },
          "into_var": "candidate_pairs",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "ClassifyVote" }
    },
    "ClassifyVote": {
      "actor": "classifiers",
      "prompt": "Classify this semantic edge candidate independently. Candidate: ${vars.candidate}. Vote yes only if the proposed edge is strongly supported by the provided labels and excerpts. Output strict JSON only: {\"vote\":\"yes|no\",\"justification\":\"...\"}.",
      "on_exit": [
        {
          "op": "parse_json",
          "args": { "from": "${ClassifyVote.output}" },
          "into_var": "votes",
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "Aggregate" }
    },
    "Aggregate": {
      "actor": "",
      "on_enter": [
        {
          "op": "aggregate_auto_edge_votes",
          "args": { "votes": "${vars.votes}" },
          "into_var": "vote_aggregate"
        }
      ],
      "gate": "domain:auto-edge/vote-aggregate",
      "prompt": "vote1=${vars.vote_aggregate.vote1} vote2=${vars.vote_aggregate.vote2} vote3=${vars.vote_aggregate.vote3}",
      "next": {
        "type": "branch",
        "cases": {
          "write_edge": "WriteEdge",
          "hold_for_review": "SurfaceToInbox",
          "reject": "Done"
        },
        "default": "SurfaceToInbox"
      }
    },
    "WriteEdge": {
      "actor": "",
      "on_enter": [
        {
          "op": "write_semantic_edge",
          "args": {
            "source": "${vars.candidate.source}",
            "target": "${vars.candidate.target}",
            "kind": "${vars.candidate.edge_kind}",
            "note": "${vars.vote_aggregate.votes}"
          },
          "into_var": "semantic_edge"
        }
      ],
      "next": { "type": "goto", "to": "Done" }
    },
    "SurfaceToInbox": {
      "actor": "",
      "on_enter": [
        {
          "op": "surface_to_inbox",
          "args": {
            "from": {
              "title": "Auto-edge candidate held for review",
              "content": "${vars.candidate}",
              "source_session": "${meta.arc_id}",
              "source_files": [],
              "source_query": "auto-edge-arc",
              "rendered": false
            }
          },
          "on_failure": "warn"
        }
      ],
      "next": { "type": "goto", "to": "Done" }
    },
    "Done": {
      "actor": "",
      "next": { "type": "terminal" }
    }
  }
}
