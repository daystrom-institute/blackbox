{
  "name": "project-bootstrap-arc",
  "version": 1,
  "policy_packet": "domain:workflow-policy/arc-budget",
  "vars_schema": {
    "project_id": { "kind": "string", "required": true },
    "project_path": { "kind": "string", "required": true },
    "repo_id": { "kind": "string" },
    "walk_complete": { "kind": "bool" },
    "chunk_complete": { "kind": "bool" },
    "index_written": { "kind": "bool" },
    "embed_enqueued": { "kind": "bool" },
    "edges_derived": { "kind": "bool" },
    "published": { "kind": "bool" }
  },
  "actors": {},
  "start": "Setup",
  "nodes": {
    "Setup": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "walk_complete", "value": false }
        }
      ],
      "next": { "type": "goto", "to": "Walk" }
    },
    "Walk": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "walk_complete", "value": true }
        }
      ],
      "next": { "type": "goto", "to": "Chunk" }
    },
    "Chunk": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "chunk_complete", "value": true }
        }
      ],
      "next": { "type": "goto", "to": "WriteIndex" }
    },
    "WriteIndex": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "index_written", "value": true }
        }
      ],
      "next": { "type": "goto", "to": "EnqueueEmbed" }
    },
    "EnqueueEmbed": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "embed_enqueued", "value": true }
        }
      ],
      "next": { "type": "goto", "to": "DeriveEdges" }
    },
    "DeriveEdges": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "edges_derived", "value": true }
        }
      ],
      "next": { "type": "goto", "to": "Publish" }
    },
    "Publish": {
      "actor": "",
      "on_enter": [
        {
          "op": "set_var",
          "args": { "key": "published", "value": true }
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
