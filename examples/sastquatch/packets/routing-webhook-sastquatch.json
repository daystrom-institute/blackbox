{
  "domain": "webhook-routing/sastquatch",
  "scope": "global",
  "classification_lattice": ["signal_arc", "ignore", "dead_letter"],
  "rules": [
    {
      "id": "signal_pr_ready_on_pr_opened",
      "classification": "signal_arc",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "event", "value": "pull_request" },
          { "op": "In", "field": "action", "values": ["opened", "reopened"] }
        ]
      },
      "consequent": "{\"route\":\"signal_arc\",\"signal\":\"pr-ready\",\"correlate\":{\"pr\":\"${entity.pr_number}\"}}"
    },
    {
      "id": "signal_pr_ready_on_synchronize",
      "classification": "signal_arc",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "event", "value": "pull_request" },
          { "op": "In", "field": "action", "values": ["synchronize", "synchronized"] }
        ]
      },
      "consequent": "{\"route\":\"signal_arc\",\"signal\":\"pr-ready\",\"correlate\":{\"pr\":\"${entity.pr_number}\"}}"
    },
    {
      "id": "signal_pr_merged",
      "classification": "signal_arc",
      "antecedent": {
        "op": "All",
        "args": [
          { "op": "Eq", "field": "event", "value": "pull_request" },
          { "op": "Eq", "field": "action", "value": "closed" },
          { "op": "Eq", "field": "merged", "value": true }
        ]
      },
      "consequent": "{\"route\":\"signal_arc\",\"signal\":\"pr-merged\",\"correlate\":{\"pr\":\"${entity.pr_number}\"}}"
    },
    {
      "id": "signal_pr_feedback",
      "classification": "signal_arc",
      "antecedent": {
        "op": "In",
        "field": "event",
        "values": [
          "pull_request_review",
          "pull_request_review_comment",
          "pull_request_review_approved",
          "pull_request_review_rejected",
          "pull_request_comment"
        ]
      },
      "consequent": "{\"route\":\"signal_arc\",\"signal\":\"pr-feedback\",\"correlate\":{\"pr\":\"${entity.pr_number}\"}}"
    },
    {
      "id": "ignore_pr_other_actions",
      "classification": "ignore",
      "antecedent": {
        "op": "Eq", "field": "event", "value": "pull_request"
      },
      "consequent": "ignore"
    },
    {
      "id": "ignore_push_events",
      "classification": "ignore",
      "antecedent": {
        "op": "Eq", "field": "event", "value": "push"
      },
      "consequent": "ignore"
    }
  ]
}
