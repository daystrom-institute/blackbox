{
  "domain": "cron-routing/sastquatch",
  "scope": "global",
  "classification_lattice": ["start_arc", "ignore"],
  "rules": [
    {
      "id": "tick_starts_arc",
      "classification": "start_arc",
      "antecedent": {
        "op": "Eq", "field": "cron_name", "value": "sastquatch-daily"
      },
      "consequent": "{\"route\":\"start_arc\",\"workflow\":\"sastquatch-arc\",\"initial_vars\":{}}"
    },
    {
      "id": "ignore_unknown_cron",
      "classification": "ignore",
      "antecedent": { "op": "True" },
      "consequent": "ignore"
    }
  ]
}
