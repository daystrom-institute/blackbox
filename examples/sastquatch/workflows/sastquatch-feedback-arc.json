{
  "name": "sastquatch-feedback-arc",
  "version": 1,
  "vars_schema": {
    "owner":         { "kind": "string", "required": true },
    "repo":          { "kind": "string", "required": true },
    "branch":        { "kind": "string", "required": true },
    "worktree_path": { "kind": "string", "required": true },
    "pr_number":     { "kind": "int",    "required": true },
    "feedback_text": { "kind": "string", "required": false },
    "sast_after_fix":{ "kind": "any" }
  },
  "actors": {
    "fixer": {
      "kind": "executor",
      "brofile": "sastquatch-fixer",
      "durable": true,
      "compaction_anchor": true,
      "requires": []
    }
  },
  "start": "AddressFeedback",
  "nodes": {
    "AddressFeedback": {
      "actor": "fixer",
      "prompt": "Reviewer feedback on PR #${vars.pr_number}:\n\n${vars.feedback_text}\n\nAddress the feedback in worktree ${vars.worktree_path} (branch ${vars.branch}). Edit, run tests if cheap, commit.\n\nDo NOT push — the workflow engine pushes mechanically once you return.\n\nReturn ONE LINE summarizing your changes.",
      "on_exit": [
        {
          "op": "mcp_call",
          "args": {
            "server": "biofilter",
            "tool": "sast_run",
            "arguments": {},
            "timeout_secs": 600
          },
          "into_var": "sast_after_fix",
          "on_failure": "warn"
        },
        {
          "op": "shell",
          "args": {
            "argv": ["git", "push", "origin", "${vars.branch}"],
            "cwd": "${vars.worktree_path}"
          },
          "on_failure": "halt"
        }
      ],
      "next": { "type": "terminal" }
    }
  }
}
