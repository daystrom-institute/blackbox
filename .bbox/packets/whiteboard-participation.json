{
  "domain": "blackbox-review/whiteboard-participation",
  "version": 1,
  "scope": "global",
  "classification_lattice": [
    "ready_debate",
    "ready_skip",
    "ready",
    "invalid"
  ],
  "prefix_inference": {},
  "rules": [
    {
      "id": "blind_all_lenses_posted",
      "classification": "ready",
      "antecedent": {
        "op": "All",
        "args": [
          {
            "op": "Eq",
            "field": "vars.board_check.phase",
            "value": "blind"
          },
          {
            "op": "Ge",
            "field": "vars.board_check.post_count",
            "value": 5
          },
          {
            "op": "Eq",
            "field": "vars.board_check.agents.soundness.has_posted",
            "value": true
          },
          {
            "op": "Eq",
            "field": "vars.board_check.agents.precision.has_posted",
            "value": true
          },
          {
            "op": "Eq",
            "field": "vars.board_check.agents.economy.has_posted",
            "value": true
          },
          {
            "op": "Eq",
            "field": "vars.board_check.agents.resilience.has_posted",
            "value": true
          },
          {
            "op": "Eq",
            "field": "vars.board_check.agents.corroboration.has_posted",
            "value": true
          }
        ]
      },
      "consequent": "ready"
    },
    {
      "id": "validation_complete_with_conflicts",
      "classification": "ready_debate",
      "antecedent": {
        "op": "All",
        "args": [
          {
            "op": "Eq",
            "field": "vars.board_check.phase",
            "value": "validate"
          },
          {
            "op": "Ge",
            "field": "vars.board_check.post_count",
            "value": 5
          },
          {
            "op": "Eq",
            "field": "vars.board_check.unvalidated_count",
            "value": 0
          },
          {
            "op": "Ge",
            "field": "vars.board_check.conflict_count",
            "value": 1
          }
        ]
      },
      "consequent": "ready_debate"
    },
    {
      "id": "validation_complete_no_conflicts",
      "classification": "ready_skip",
      "antecedent": {
        "op": "All",
        "args": [
          {
            "op": "Eq",
            "field": "vars.board_check.phase",
            "value": "validate"
          },
          {
            "op": "Ge",
            "field": "vars.board_check.post_count",
            "value": 5
          },
          {
            "op": "Eq",
            "field": "vars.board_check.unvalidated_count",
            "value": 0
          },
          {
            "op": "Eq",
            "field": "vars.board_check.conflict_count",
            "value": 0
          }
        ]
      },
      "consequent": "ready_skip"
    },
    {
      "id": "debate_participation_complete",
      "classification": "ready",
      "antecedent": {
        "op": "All",
        "args": [
          {
            "op": "Eq",
            "field": "vars.board_check.phase",
            "value": "debate"
          },
          {
            "op": "Ge",
            "field": "vars.board_check.post_count",
            "value": 5
          },
          {
            "op": "Eq",
            "field": "vars.board_check.unreviewed_post_count",
            "value": 0
          },
          {
            "op": "Ge",
            "field": "vars.board_check.vote_count",
            "value": 1
          }
        ]
      },
      "consequent": "ready"
    },
    {
      "id": "invalid_default",
      "classification": "invalid",
      "antecedent": {
        "op": "True"
      },
      "consequent": "invalid"
    }
  ]
}
