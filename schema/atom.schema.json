{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox.local/schema/atom.schema.json",
  "title": "Blackbox Atom Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["_contract", "kind", "name", "version", "manifest"],
  "properties": {
    "_contract": {
      "const": "atom/v1"
    },
    "kind": {
      "const": "atom"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "subcontract": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "when_to_use", "implementation"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "when_to_use": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {},
            "prompt_template": {
              "type": "string"
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {},
            "evidence_density": {
              "enum": ["low", "medium", "high"]
            }
          }
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "writes_files": {},
            "dispatches_runs": {},
            "max_depth": {},
            "uses_network": {}
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["may_invoke_atoms"],
          "properties": {
            "may_invoke_atoms": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {
                  "enum": ["none", "any", "allowed"]
                },
                "atoms": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^atom:[^@]+@(v[1-9][0-9]*|latest)$"
                  }
                }
              }
            }
          }
        },
        "implementation": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["profile", "workflow", "deterministic", "adapter"]
            },
            "brofile_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^brofile:[^@]+@(v[1-9][0-9]*|latest)$"
            },
            "workflow_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^workflow:[^@]+@(v[1-9][0-9]*|latest)$"
            },
            "runner": {
              "type": "string",
              "minLength": 1
            },
            "adapter_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "supervision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oracle": {
              "type": "string",
              "pattern": "^(none|default|atom:[^@]+@(v[1-9][0-9]*|latest))$"
            },
            "advisor": {
              "type": "string",
              "pattern": "^(none|on_alert|always|atom:[^@]+@(v[1-9][0-9]*|latest))$"
            }
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retain": {
              "enum": ["none", "summary", "full"]
            },
            "portal_focus": {
              "enum": ["never", "on_request", "on_attention", "always"]
            }
          }
        },
        "cost_class": {
          "enum": ["cheap", "normal", "expensive"]
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "author"],
              "properties": {
                "kind": { "const": "hand_authored" },
                "author": { "type": "string", "minLength": 1 },
                "created_at": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "distilled_by"],
              "properties": {
                "kind": { "const": "distilled" },
                "distilled_by": { "type": "string", "minLength": 1 },
                "evidence_session_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "created_from_threads": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "accept_count": { "type": "integer", "minimum": 0 },
                "reject_count": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source"],
              "properties": {
                "kind": { "const": "imported" },
                "source": { "type": "string", "minLength": 1 },
                "import_at": { "type": "string" }
              }
            }
          ]
        },
        "embedding": {
          "type": "object"
        }
      }
    }
  }
}
