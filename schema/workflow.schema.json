{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackbox.local/schema/workflow.schema.json",
  "title": "Blackbox Workflow Spec",
  "description": "A protocol-level description of actor interaction over time. Control flow is encoded as per-node `next` transitions (goto / branch / fork / terminal); there is no separate graph representation.",
  "type": "object",
  "required": ["name", "version", "actors", "nodes", "start"],
  "additionalProperties": false,
  "properties": {
    "name":          { "type": "string", "minLength": 1 },
    "version":       { "type": "integer", "minimum": 0 },
    "actors":        {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/ActorSpec" }
    },
    "atom_bindings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/AtomBinding" },
      "description": "Workflow-local bindings from node ids to standalone atom refs."
    },
    "nodes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/NodeSpec" }
    },
    "start": {
      "type": "string",
      "minLength": 1,
      "description": "Entry node id — must reference a key in `nodes`."
    },
    "policy_packet": {
      "type": ["string", "null"],
      "description": "Optional packet ID applied at each node boundary. Verdicts: `halt` (stop arc as error), `escalate` (write blocked note, continue), `warn` (write surprise note, continue). Other verdicts are no-ops."
    },
    "vars_schema": { "$ref": "#/definitions/VarsSchema" },
    "on_arc_exit": {
      "type": "array",
      "items": { "$ref": "#/definitions/HookOp" }
    },
    "on_arc_cancel": {
      "type": "array",
      "items": { "$ref": "#/definitions/HookOp" }
    }
  },

  "definitions": {
    "ActorSpec": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind":              { "$ref": "#/definitions/ActorKind" },
        "brofile":           { "type": ["string", "null"] },
        "team":              { "type": ["string", "null"] },
        "durable":           { "type": "boolean", "default": false },
        "compaction_anchor": { "type": "boolean", "default": false },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/definitions/Capability" }
        },
        "runtime": { "type": ["object", "null"] },
        "terminal_mode": { "enum": ["native", "tmux"], "default": "native" }
      }
    },

    "ActorKind": {
      "type": "string",
      "enum": ["executor", "ensemble", "advisor", "user"]
    },

    "AtomBinding": {
      "type": "object",
      "required": ["atom_ref"],
      "additionalProperties": false,
      "properties": {
        "id":                { "type": ["string", "null"], "minLength": 1 },
        "atom_ref":          {
          "type": "string",
          "pattern": "^atom:[^@]+@(v[1-9][0-9]*|latest)$"
        },
        "durable":           { "type": "boolean", "default": false },
        "compaction_anchor": { "type": "boolean", "default": false },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/definitions/Capability" }
        },
        "limits":            { "$ref": "#/definitions/AtomBindingLimits" },
        "supervision_override": { "$ref": "#/definitions/SupervisionPlanOverride" },
        "trace_override": {},
        "portal": {}
      }
    },

    "SupervisionPlanOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classifier": { "$ref": "#/definitions/SupervisionClassifierOverride" },
        "advisor": { "$ref": "#/definitions/SupervisionAdvisorOverride" },
        "recovery": { "$ref": "#/definitions/SupervisionRecoveryOverride" },
        "trigger": { "$ref": "#/definitions/SupervisionTriggerOverride" },
        "tail_policy": { "$ref": "#/definitions/SupervisionTailPolicyOverride" },
        "alert_dedup": { "$ref": "#/definitions/SupervisionAlertDedupOverride" }
      }
    },

    "SupervisionClassifierOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["none", "on_mechanical_alert", "cadence", "cadence_or_alert", "turn_end_only"]
        },
        "atom_ref": {
          "type": "string",
          "pattern": "^atom:[^@]+@(v[1-9][0-9]*|latest)$"
        },
        "required": { "type": "boolean" },
        "cadence_ms": { "type": "integer", "minimum": 1 },
        "max_polls": { "type": "integer", "minimum": 0 },
        "alerting_classifications": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "runtime": { "$ref": "#/definitions/SupervisionRuntimeIntent" }
      }
    },

    "SupervisionAdvisorOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["none", "on_alert", "always"] },
        "atom_ref": {
          "type": "string",
          "pattern": "^atom:[^@]+@(v[1-9][0-9]*|latest)$"
        },
        "durable": { "type": "boolean" },
        "runtime": { "$ref": "#/definitions/SupervisionRuntimeIntent" }
      }
    },

    "SupervisionRecoveryOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "tier_ladder": { "type": "string", "minLength": 1 },
        "tier_mode": { "enum": ["exact", "at_least", "bounded"] },
        "runtime": { "$ref": "#/definitions/SupervisionRuntimeIntent" }
      }
    },

    "SupervisionTriggerOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mechanical_alerts": { "type": "boolean" },
        "turn_end": { "type": "boolean" }
      }
    },

    "SupervisionTailPolicyOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "notes": { "type": "integer", "minimum": 0 },
        "assistant_bytes": { "type": "integer", "minimum": 0 },
        "reports": { "type": "integer", "minimum": 0 }
      }
    },

    "SupervisionAlertDedupOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "window_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "SupervisionRuntimeIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": { "type": "string", "minLength": 1 },
        "tier_ladder": { "type": "string", "minLength": 1 },
        "tier_mode": { "enum": ["exact", "at_least", "bounded"] },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "selection_policy": { "type": "string", "minLength": 1 }
      }
    },

    "AtomBindingLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writes_files": {
          "oneOf": [
            { "type": "boolean" },
            { "const": "unbounded" }
          ]
        },
        "dispatches_runs": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "unbounded" }
          ]
        },
        "max_depth": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "const": "unbounded" }
          ]
        },
        "uses_network": {
          "oneOf": [
            { "type": "boolean" },
            { "const": "unbounded" }
          ]
        }
      }
    },

    "Capability": {
      "description": "Provider capability requirement. Validated against the actor's brofile/team → provider/model catalog at compile time.",
      "type": "string"
    },

    "NodeSpec": {
      "type": "object",
      "required": ["next"],
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "default": "",
          "description": "Name of the actor to invoke. Empty string = hook-only / pure-routing node (no actor dispatch)."
        },
        "atom": {
          "type": "string",
          "default": "",
          "description": "Name of an atom binding to invoke."
        },
        "atom_args": {
          "description": "Structured atom input arguments, resolved through ArcContext templating at dispatch.",
          "type": ["array", "object", "string", "number", "integer", "boolean", "null"]
        },
        "prompt":           { "type": ["string", "null"] },
        "gate":             { "type": ["string", "null"] },
        "gate_mode":        { "$ref": "#/definitions/GateMode" },
        "mode":             { "$ref": "#/definitions/NodeMode" },
        "retry":            { "$ref": "#/definitions/RetryPolicy" },
        "late_inject":      { "$ref": "#/definitions/LateInject" },
        "subworkflow":      { "$ref": "#" },
        "subworkflow_ref":  { "type": ["string", "null"] },
        "imports":          { "type": "array", "items": { "type": "string" } },
        "exports":          { "type": "array", "items": { "type": "string" } },
        "import_renames":   {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "on_enter":         { "type": "array", "items": { "$ref": "#/definitions/HookOp" } },
        "on_exit":          { "type": "array", "items": { "$ref": "#/definitions/HookOp" } },
        "wait":             { "$ref": "#/definitions/WaitSpec" },
        "sleep":            { "$ref": "#/definitions/SleepSpec" },
        "wait_for": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names of nodes whose in-flight outputs must be joined before this node's body runs (explicit fan-in for fork → join patterns)."
        },
        "foreach":         { "$ref": "#/definitions/ForeachSpec" },
        "matrix":          { "$ref": "#/definitions/MatrixSpec" },
        "next": { "$ref": "#/definitions/NodeTransition" }
      }
    },

    "ForeachSpec": {
      "type": "object",
      "required": ["items", "as_var", "collect"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["subworkflow"], "not": { "required": ["subworkflow_ref"] } },
        { "required": ["subworkflow_ref"], "not": { "required": ["subworkflow"] } }
      ],
      "properties": {
        "items": {
          "description": "JSON value resolved at dispatch through ArcContext templating. Must resolve to an array.",
          "type": ["array", "object", "string", "number", "integer", "boolean", "null"]
        },
        "as_var":           { "type": "string", "minLength": 1 },
        "index_as":         { "type": ["string", "null"], "minLength": 1 },
        "key":              { "type": ["string", "null"] },
        "subworkflow":      { "$ref": "#" },
        "subworkflow_ref":  { "type": ["string", "null"] },
        "imports":          { "type": "array", "items": { "type": "string" } },
        "exports":          { "type": "array", "items": { "type": "string" } },
        "import_renames":   {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "parallelism":      { "type": ["integer", "null"], "minimum": 1, "maximum": 16 },
        "collect":          { "$ref": "#/definitions/ForeachCollect" },
        "on_item_failure":  { "$ref": "#/definitions/ItemFailurePolicy" }
      }
    },

    "MatrixSpec": {
      "type": "object",
      "required": ["axes", "as_var", "collect"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["subworkflow"], "not": { "required": ["subworkflow_ref"] } },
        { "required": ["subworkflow_ref"], "not": { "required": ["subworkflow"] } }
      ],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/MatrixAxis" }
        },
        "as_var":           { "type": "string", "minLength": 1 },
        "index_as":         { "type": ["string", "null"], "minLength": 1 },
        "key":              { "type": ["string", "null"] },
        "subworkflow":      { "$ref": "#" },
        "subworkflow_ref":  { "type": ["string", "null"] },
        "imports":          { "type": "array", "items": { "type": "string" } },
        "exports":          { "type": "array", "items": { "type": "string" } },
        "import_renames":   {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "parallelism":      { "type": ["integer", "null"], "minimum": 1, "maximum": 16 },
        "collect":          { "$ref": "#/definitions/ForeachCollect" },
        "on_item_failure":  { "$ref": "#/definitions/ItemFailurePolicy" }
      }
    },

    "MatrixAxis": {
      "type": "object",
      "required": ["name", "values"],
      "additionalProperties": false,
      "properties": {
        "name":   { "type": "string", "minLength": 1 },
        "values": {
          "description": "JSON value resolved at dispatch through ArcContext templating. Must resolve to an array.",
          "type": ["array", "object", "string", "number", "integer", "boolean", "null"]
        }
      }
    },

    "ForeachCollect": {
      "type": "object",
      "required": ["into_var"],
      "additionalProperties": false,
      "properties": {
        "into_var": { "type": "string", "minLength": 1 }
      }
    },

    "ItemFailurePolicy": {
      "type": "string",
      "enum": ["halt", "collect_then_halt", "continue"],
      "default": "halt"
    },

    "NodeTransition": {
      "description": "Per-node control-flow successor. Tagged union — the `type` discriminator selects the variant.",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "to"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "goto" },
            "to":   { "type": "string", "description": "Target node id (forward edge or back-edge for cycles)." }
          }
        },
        {
          "type": "object",
          "required": ["type", "cases"],
          "additionalProperties": false,
          "properties": {
            "type":    { "const": "branch" },
            "on":      { "$ref": "#/definitions/BranchSelector" },
            "cases": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string" },
              "description": "Map of selector value → target node id. Keys SHOULD match the gate packet's classification lattice."
            },
            "default": {
              "type": ["string", "null"],
              "description": "Fallback target for selector values not enumerated in `cases`. Without this, an unmatched verdict halts the arc."
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "branches", "continue_to"],
          "additionalProperties": false,
          "properties": {
            "type":        { "const": "fork" },
            "branches": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "Side-branches dispatched fire-and-forget."
            },
            "continue_to": { "type": "string", "description": "Where the main walk advances after dispatching the side-branches." }
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "terminal" }
          }
        }
      ]
    },

    "BranchSelector": {
      "type": "string",
      "enum": ["gate_verdict"],
      "default": "gate_verdict",
      "description": "Source of the value matched against `cases`. v1 only supports `gate_verdict`."
    },

    "GateMode": {
      "type": "string",
      "enum": ["first", "all"],
      "default": "first"
    },

    "NodeMode": {
      "type": "string",
      "enum": ["sync", "fire_and_forget"],
      "default": "sync"
    },

    "RetryPolicy": {
      "type": "object",
      "required": ["max_generations"],
      "additionalProperties": false,
      "properties": {
        "max_generations": { "type": "integer", "minimum": 1 }
      }
    },

    "LateInject": {
      "type": "object",
      "required": ["from", "policy"],
      "additionalProperties": false,
      "properties": {
        "from":   { "type": "string", "description": "Node id whose output is folded into this node's brief when it becomes available." },
        "policy": { "type": "string", "enum": ["resume_on_return"] }
      }
    },

    "VarsSchema": {
      "description": "Map of var name → kind/required pair. Keys validated when hooks write to vars and when initial vars seed at arc start.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind":     { "type": "string", "enum": ["string", "int", "bool", "array", "object", "any"] },
          "required": { "type": "boolean", "default": false }
        }
      }
    },

    "WaitSpec": {
      "type": "object",
      "required": ["any_of"],
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/WaitSignal" }
        },
        "timeout": {
          "description": "Duration string (e.g. \"24h\", \"7d\"). Absent = wait indefinitely.",
          "type": ["string", "null"]
        }
      }
    },

    "SleepSpec": {
      "type": "object",
      "required": ["duration_ms"],
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Duration to sleep in milliseconds."
        }
      }
    },

    "WaitSignal": {
      "type": "object",
      "required": ["signal"],
      "additionalProperties": false,
      "properties": {
        "signal":    { "type": "string" },
        "correlate": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/Selector" },
          "description": "Correlation tuple. Keys → selectors evaluated against ArcContext at Wait registration time."
        }
      }
    },

    "Selector": {
      "description": "Value extractor against the ArcContext flatten. Tagged by `kind`.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "json_path" },
            "path": { "type": "string", "description": "Dotted path (leading `$.` optional). E.g. `vars.pr_number`." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind":  { "const": "const" },
            "value": {}
          }
        },
        {
          "type": "object",
          "required": ["kind", "inner", "fallback"],
          "additionalProperties": false,
          "properties": {
            "kind":     { "const": "default" },
            "inner":    { "$ref": "#/definitions/Selector" },
            "fallback": {}
          }
        },
        {
          "type": "object",
          "required": ["kind", "parts"],
          "additionalProperties": false,
          "properties": {
            "kind":  { "const": "concat" },
            "parts": { "type": "array", "items": { "$ref": "#/definitions/Selector" } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "sources"],
          "additionalProperties": false,
          "properties": {
            "kind":    { "const": "coalesce" },
            "sources": { "type": "array", "items": { "$ref": "#/definitions/Selector" } }
          }
        }
      ]
    },

    "HookOp": {
      "description": "Hook operation. Schema deliberately open — full op catalog lives in `src/workflow/ops.rs`. Common fields shown.",
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "description": "Op name (e.g. `set_var`, `inc_var`, `http_json`, `shell`, `worktree_create`, `worktree_remove`, `parse_json`, `find_first`)."
        },
        "args":        { "description": "Op-specific arguments." },
        "into_var":    { "type": "string", "description": "Optional var name to receive the op's result." },
        "when":        { "type": "string", "description": "Optional gate packet ID — op runs only if verdict is `allow|pass|proceed|fire|ok|delete|keep|yes|true`." },
        "on_failure": {
          "type": "string",
          "enum": ["halt", "warn", "continue"],
          "default": "halt",
          "description": "Failure policy: halt the arc, write a warning note, or continue silently."
        }
      }
    }
  }
}
