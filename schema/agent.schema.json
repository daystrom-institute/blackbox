{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackbox.local/schema/agent.schema.json",
  "title": "Blackbox Agent Artifact",
  "description": "Legacy registered-agent artifact schema. New reusable capabilities should use atom.schema.json with kind=atom and _contract=atom/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "version", "manifest"],
  "properties": {
    "kind": {
      "const": "agent"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "_contract": {
      "type": "string"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "when_to_use"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "when_to_use": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "brofile_ref": {
          "type": "string",
          "minLength": 1
        },
        "brofile_inline": {
          "type": "object"
        },
        "filter_overlay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "disallow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {},
            "prompt_template": {
              "type": "string"
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {},
            "evidence_density": {
              "enum": ["low", "medium", "high"]
            }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chainable_after": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "parallel_safe": {
              "type": "boolean"
            },
            "fan_out_aggregator": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cost_class": {
          "enum": ["cheap", "normal", "expensive"]
        },
        "dispatch_adapter": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "author"],
              "properties": {
                "kind": { "const": "hand_authored" },
                "author": { "type": "string", "minLength": 1 },
                "created_at": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "distilled_by"],
              "properties": {
                "kind": { "const": "distilled" },
                "distilled_by": { "type": "string", "minLength": 1 },
                "evidence_session_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "created_from_threads": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "accept_count": { "type": "integer", "minimum": 0 },
                "reject_count": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source"],
              "properties": {
                "kind": { "const": "imported" },
                "source": { "type": "string", "minLength": 1 },
                "import_at": { "type": "string" }
              }
            }
          ]
        },
        "embedding": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": ["brofile_ref"],
          "not": { "required": ["brofile_inline"] }
        },
        {
          "required": ["brofile_inline"],
          "not": { "required": ["brofile_ref"] }
        }
      ]
    }
  }
}
